    route_type(methodes, patrons, handlers, "GET", "/v1/discord/bot", api_discord_bot)
    route_type(methodes, patrons, handlers, "POST", "/v1/discord/webhook", api_discord_webhook)
    route_type(methodes, patrons, handlers, "POST", "/v1/smtp/:idsmtp/send", api_smtp_send)
    route_type(methodes, patrons, handlers, "GET", "/v1/smtp/:idsmtp/pool", api_smtp_pool)
    route_type(methodes, patrons, handlers, "DELETE", "/v1/smtp/:idsmtp/remove", api_smtp_remove)
    route_type(methodes, patrons, handlers, "GET", "/v1/admin/user/", api_admin_users)
    route_type(methodes, patrons, handlers, "GET", "/v1/admin/ia/", fn (r: Requete, _p: Map<Text>) -> WebResultat { return api_admin_config(r,"ia") })
    route_type(methodes, patrons, handlers, "GET", "/v1/admin/smtp/", fn (r: Requete, _p: Map<Text>) -> WebResultat { return api_admin_config(r,"smtp") })
    route_type(methodes, patrons, handlers, "POST", "/v1/admin/smtp/", api_admin_smtp_create)
    route_type(methodes, patrons, handlers, "GET", "/v1/admin/crawler/", fn (r: Requete, _p: Map<Text>) -> WebResultat { return api_admin_config(r,"crawler") })
    route_type(methodes, patrons, handlers, "GET", "/v1/admin/discord/", fn (r: Requete, _p: Map<Text>) -> WebResultat { return api_admin_config(r,"discord") })
    return routeur_dispatch_type(methodes, patrons, handlers, req)
}

fn main() {
    let secret = unwrap_or(env("NOLIAE_SESSION_SECRET"), "")
    if len(secret) < 32 { print("NOLIAE_SESSION_SECRET doit contenir au moins 32 caracteres"); return }
    let port = unwrap_or(parse_int(unwrap_or(env("NOLIAE_PORT"), "8080")), 8080)
    let limites = web_limites_defaut()
    var pre: List<Fn(Requete) -> Option<Reponse>> = []
    var post: List<Fn(Requete, Reponse) -> Reponse> = []
    push(post, middleware_securite)
    push(post, middleware_request_id)
    push(post, middleware_cors_configurable)
    print("NolCore sur http://0.0.0.0:" + text(port))
    let ecoute = tcp_listen(port)
    if not has(ecoute) { print("port indisponible"); return }
    let serveur = unwrap_or(ecoute, -1)
    while true {
        let venu = tcp_accept(serveur)
        if has(venu) {
            let client = unwrap_or(venu, -1)
            let requete = lire_requete_http_complete(client, limites)
            let reponse = web_repondre_resultat_pre(requete, limites, application, pre, post)
            let _ecrit = tcp_write(client, reponse)
            tcp_close(client)
        }
    }
}
