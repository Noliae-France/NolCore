fn db() -> Option<Ptr<PgConn>> { return pg_ouvrir(unwrap_or(env("NOLCORE_DATABASE_URL"), "")) }

fn ip_requete(req: Requete) -> Text { return unwrap_or(requete_entete(req, "X-Forwarded-For"), "unknown") }

fn cookie_session(secret: Text, email: Text, ip: Text) -> Option<Text> {
    let nonce = random_hex(32)
    if not has(nonce) { return none }
    let ts = text(maintenant_epoch())
    let brut = email + "|" + ts + "|" + unwrap_or(nonce, "")
    let signature = hmac_sha256_hex(bytes_from_text(secret), bytes_from_text(brut + "|" + ip))
    return some(brut + "|" + signature)
}

fn erreur_json(code: Int, titre: Text, detail: Text, req: Requete) -> WebResultat {
    return WebResultat.WebEchec(erreur_http(code, titre, detail, requete_id(req)))
}

fn champ_entree(req: Requete, nom: Text) -> Option<Text> {
    let json = requete_json(req)
    if has(json) { return json_texte_champ(unwrap_or(json, ""), nom) }
    return requete_form(req, nom)
}

fn url_query_brave(v: Text) -> Text {
    var out = replace(v, "%", "%25")
    out = replace(out, " ", "%20")
    out = replace(out, "&", "%26")
    out = replace(out, "?", "%3F")
    out = replace(out, "#", "%23")
    return out
}

// Brave sert uniquement d'amorce : les URL retournées sont déposées dans une
// file PostgreSQL, puis le worker crawler les visite hors du chemin utilisateur.
fn planifier_crawl_brave(conn: Ptr<PgConn>, corps: Text) {
    var i = 0
    while i < 10 {
        let url = json_chemin_texte(corps, "web.results." + text(i) + ".url")
        if has(url) and starts_with(unwrap_or(url, ""), "https://") {
            let added = pg_requete_params(conn, "INSERT INTO search_crawl_queue(url) VALUES($1) ON CONFLICT (url) DO NOTHING", [unwrap_or(url, "")])
            if has(added) { pg_liberer(unwrap_or(added, ptr_null())) }
        }
        i = i + 1
    }
}

// CORS n'est jamais ouvert à "*" : les applications déployées sont déclarées
// dans NOLCORE_ALLOWED_ORIGINS, séparées par des virgules. Cela permet de
// changer de domaine sans modifier ni recompiler le Core.
fn middleware_cors_configurable(req: Requete, rep: Reponse) -> Reponse {
    let origine = requete_entete(req, "Origin")
    if not has(origine) { return rep }
    let recu = unwrap_or(origine, "")
    for candidate in split(unwrap_or(env("NOLCORE_ALLOWED_ORIGINS"), ""), ",") {
        if trim(candidate) == recu and recu != "" {
            var out = reponse_cors(rep, recu, "GET, POST, DELETE, OPTIONS", "Content-Type, Authorization, X-CSRF-Token")
            out = reponse_avec_entete(out, "Access-Control-Allow-Credentials", "true")
            return out
        }
    }
    return rep
}

// tcp_read peut retourner une requête HTTP fragmentée. Attendre jusqu'à ce que
// le parseur HTTP dispose de tous les octets évite les faux 408 sur POST.
fn lire_requete_http_complete(fd: Int, limites: WebLimites) -> Text {
    var buf = ""
    while true {
        let morceau = tcp_read(fd)
        if not has(morceau) { return buf }
        buf += unwrap_or(morceau, "")
        if len(buf) > limites.max_entetes + limites.max_corps + 8192 { return buf }
        match http_analyser(buf, limites.max_entetes, limites.max_corps) {
            Complet(_req) => return buf
            Erreur(_code) => return buf
            Incomplet => {}
        }
    }
    return buf
}

fn utilisateur(req: Requete, secret: Text) -> Option<Text> {
    let token = requete_bearer(req)
    if has(token) {
        let session = session_verifie(secret, unwrap_or(token, ""), maintenant_epoch())
        if has(session) {
            let sujet = unwrap_or(session, SessionSigne { sujet: "", expiration: 0, nonce: "" }).sujet
            let conn = db()
            if not has(conn) { return none }
            let hash = hmac_sha256_hex(bytes_from_text(secret), bytes_from_text(unwrap_or(token,"")))
            let res = pg_requete_params(unwrap_or(conn,ptr_null()), "SELECT user_id FROM user_sessions WHERE bearer_token_hash=$1 AND user_id=$2 AND revoked=false AND expires_at > now()", [hash,sujet])
            if not has(res) { pg_fermer(unwrap_or(conn,ptr_null())); return none }
            let sortie = unwrap_or(res,ptr_null())
            if pg_lignes(sortie) != 1 { pg_liberer(sortie); pg_fermer(unwrap_or(conn,ptr_null())); return none }
            pg_liberer(sortie); pg_fermer(unwrap_or(conn,ptr_null()))
            return some(sujet)
        }
    }
    let cookie = requete_cookie(req, "nol_session")
    if not has(cookie) { return none }
    let morceaux = split(unwrap_or(cookie, ""), "|")
    if len(morceaux) != 4 { return none }
    let email = get(morceaux,0)
    let ts = get(morceaux,1)
    let nonce = get(morceaux,2)
    let signature = get(morceaux,3)
    let attendu = hmac_sha256_hex(bytes_from_text(secret), bytes_from_text(email + "|" + ts + "|" + nonce + "|" + ip_requete(req)))
    if not bytes_egal_ct(unwrap_or(hex_decode(attendu),bytes_new()), unwrap_or(hex_decode(signature),bytes_new())) { return none }
    let conn = db()
    if not has(conn) { return none }
    let hash = hmac_sha256_hex(bytes_from_text(secret), bytes_from_text(unwrap_or(cookie,"")))
    let res = pg_requete_params(unwrap_or(conn,ptr_null()), "SELECT s.user_id FROM user_sessions s JOIN users u ON u.id=s.user_id WHERE s.token_hash=$1 AND s.email=$2 AND u.email=$2 AND s.ip=$3 AND s.revoked=false AND s.expires_at > now()", [hash,email,ip_requete(req)])
    if not has(res) { pg_fermer(unwrap_or(conn,ptr_null())); return none }
    let sortie = unwrap_or(res,ptr_null())
    if pg_lignes(sortie) != 1 { pg_liberer(sortie); pg_fermer(unwrap_or(conn,ptr_null())); return none }
    let id = pg_valeur(sortie,0,0)
    pg_liberer(sortie); pg_fermer(unwrap_or(conn,ptr_null()))
    return id
}

fn api_sante(_req: Requete, _params: Map<Text>) -> WebResultat {
    return WebResultat.WebOk(reponse_json("{\"status\":\"ok\",\"runtime\":\"nolc\",\"service\":\"nolcore\"}"))
}

fn api_dependances(req: Requete, _params: Map<Text>) -> WebResultat {
    let crawler_url = unwrap_or(env("NOLCORE_CRAWLER_URL"), "")
    let ia_url = unwrap_or(env("NOLCORE_IA_URL"), "")
    if crawler_url == "" or ia_url == "" { return erreur_json(503,"Service Unavailable","Services internes non configurés.",req) }
    let crawler = http_get(crawler_url + "/api/health")
    let ia = http_get(ia_url + "/api/health")
    if not has(crawler) or not has(ia) { return erreur_json(503,"Service Unavailable","Une dépendance interne est indisponible.",req) }
    let crawler_rep = unwrap_or(crawler,ReponseHttp {statut:0,entetes:"",corps:""})
    let ia_rep = unwrap_or(ia,ReponseHttp {statut:0,entetes:"",corps:""})
    if crawler_rep.statut >= 300 or ia_rep.statut >= 300 { return erreur_json(503,"Service Unavailable","Une dépendance interne est indisponible.",req) }
    return WebResultat.WebOk(reponse_json("{\"status\":\"ok\",\"crawler\":\"ok\",\"ia\":\"ok\"}"))
}

fn api_pret(_req: Requete, _params: Map<Text>) -> WebResultat {
    let conn = db()
    if not has(conn) { return erreur_json(503,"Service Unavailable","PostgreSQL indisponible.",_req) }
    let res = pg_requete(unwrap_or(conn,ptr_null()), "SELECT 1")
    if has(res) { pg_liberer(unwrap_or(res,ptr_null())) }
    pg_fermer(unwrap_or(conn,ptr_null()))
    if not has(res) { return erreur_json(503,"Service Unavailable","PostgreSQL indisponible.",_req) }
    return WebResultat.WebOk(reponse_json("{\"status\":\"ready\",\"database\":\"ok\"}"))
}

fn api_capacites(_req: Requete, _params: Map<Text>) -> WebResultat {
    return WebResultat.WebOk(reponse_json("{\"modules\":[\"users\",\"auth\",\"ia\",\"recherche\",\"postgresql\",\"permissions\",\"administration\"]}"))
}

// Identité publique, lue depuis PostgreSQL. Le Core reste volontairement
// neutre : "NolCore" est le seul repli lorsqu'une base est indisponible.
fn api_branding(_req: Requete, _params: Map<Text>) -> WebResultat {
    let conn = db()
    if not has(conn) { return WebResultat.WebOk(reponse_json("{\"name\":\"NolCore\",\"logo_url\":\"\",\"website_url\":\"\"}")) }
    let res = pg_requete(unwrap_or(conn,ptr_null()), "SELECT name,logo_url,website_url,search_url,ia_url,login_url,register_url,account_url,api_url FROM instance_branding WHERE id=true LIMIT 1")
    if not has(res) or pg_lignes(unwrap_or(res,ptr_null())) != 1 {
        if has(res) { pg_liberer(unwrap_or(res,ptr_null())) }
        pg_fermer(unwrap_or(conn,ptr_null()))
        return WebResultat.WebOk(reponse_json("{\"name\":\"NolCore\",\"logo_url\":\"\",\"website_url\":\"\"}"))
    }
    let lignes = unwrap_or(res,ptr_null())
    let payload = "{\"name\":" + json_texte(unwrap_or(pg_valeur(lignes,0,0),"NolCore")) + ",\"logo_url\":" + json_texte(unwrap_or(pg_valeur(lignes,0,1),"")) + ",\"website_url\":" + json_texte(unwrap_or(pg_valeur(lignes,0,2),"")) + ",\"search_url\":" + json_texte(unwrap_or(pg_valeur(lignes,0,3),"")) + ",\"ia_url\":" + json_texte(unwrap_or(pg_valeur(lignes,0,4),"")) + ",\"login_url\":" + json_texte(unwrap_or(pg_valeur(lignes,0,5),"")) + ",\"register_url\":" + json_texte(unwrap_or(pg_valeur(lignes,0,6),"")) + ",\"account_url\":" + json_texte(unwrap_or(pg_valeur(lignes,0,7),"")) + ",\"api_url\":" + json_texte(unwrap_or(pg_valeur(lignes,0,8),"")) + "}"
    pg_liberer(lignes); pg_fermer(unwrap_or(conn,ptr_null()))
    return WebResultat.WebOk(reponse_json(payload))
}

fn api_register(req: Requete, _params: Map<Text>) -> WebResultat {
    let email = champ_entree(req, "email")
    let nom = champ_entree(req, "name")
    let mot = champ_entree(req, "password")
    if not has(email) or not has(nom) or not has(mot) { return erreur_json(422, "Unprocessable Content", "email, name et password sont obligatoires.", req) }
    let secret = bytes_from_text(unwrap_or(mot, ""))
    let hash = mot_de_passe_hache(secret)
    if not has(hash) { return erreur_json(500, "Internal Server Error", "Hachage indisponible.", req) }
    let conn = db()
    if not has(conn) { return erreur_json(503, "Service Unavailable", "Base PostgreSQL indisponible.", req) }
    let res = pg_requete_params(unwrap_or(conn, ptr_null()), "INSERT INTO users(email,display_name,password_hash) VALUES($1,$2,$3) RETURNING id,email,display_name,role", [unwrap_or(email, ""), unwrap_or(nom, ""), unwrap_or(hash, "")])
    if not has(res) { pg_fermer(unwrap_or(conn, ptr_null())); return erreur_json(409, "Conflict", "Email déjà utilisé.", req) }
    let sortie = unwrap_or(res, ptr_null())
    let id = unwrap_or(pg_valeur(sortie, 0, 0), "")
    let token = random_hex(32)
    if not has(token) { pg_liberer(sortie); pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(500,"Internal Server Error","Token de vérification indisponible.",req) }
    let token_hash = hmac_sha256_hex(bytes_from_text(unwrap_or(env("NOLIAE_SESSION_SECRET"),"")), bytes_from_text(unwrap_or(token,"")))
    let saved_token = pg_requete_params(unwrap_or(conn,ptr_null()), "INSERT INTO email_verification_tokens(token_hash,user_id,expires_at) VALUES($1,$2,now()+interval '24 hours')", [token_hash,id])
    if has(saved_token) { pg_liberer(unwrap_or(saved_token,ptr_null())) }
    let smtp_id = unwrap_or(env("NOLCORE_VERIFICATION_SMTP_ID"),"")
    if mail_api_disponible() or smtp_id != "" {
        let url = unwrap_or(env("NOLCORE_PUBLIC_URL"),"http://localhost:8080") + "/v1/user/verify?token=" + unwrap_or(token,"")
        var delivered = false
        if mail_api_disponible() {
            // Prioritaire : la plupart des hébergeurs (dont OVH) bloquent le
            // SMTP sortant direct depuis un VPS. L'API Mail HTTPS le contourne.
            let from = unwrap_or(env("NOLCORE_VERIFICATION_FROM"),"no-reply@noliae.com")
            delivered = mail_api_envoyer(from, unwrap_or(email,""), "Vérifiez votre compte Noliae", "Cliquez ici pour vérifier votre compte : " + url)
        } else {
            let profile = pg_requete_params(unwrap_or(conn,ptr_null()), "SELECT host,port,username,secret_env FROM smtp_profiles WHERE id=$1 AND enabled=true", [smtp_id])
            if not has(profile) or pg_lignes(unwrap_or(profile,ptr_null())) != 1 { if has(profile) { pg_liberer(unwrap_or(profile,ptr_null())) }; pg_liberer(sortie); pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(503,"Service Unavailable","SMTP de vérification indisponible.",req) }
            let p = unwrap_or(profile,ptr_null())
            let host = unwrap_or(pg_valeur(p,0,0),"")
            let port = unwrap_or(parse_int(unwrap_or(pg_valeur(p,0,1),"465")),465)
            let username = unwrap_or(pg_valeur(p,0,2),"")
            let password = unwrap_or(env(unwrap_or(pg_valeur(p,0,3),"")),"")
            let from = unwrap_or(env("NOLCORE_VERIFICATION_FROM"),username)
            delivered = smtp_envoyer(host,port,username,password,from,unwrap_or(email,""),"Vérifiez votre compte Noliae","Cliquez ici pour vérifier votre compte : " + url)
            pg_liberer(p)
        }
        if not delivered { pg_liberer(sortie); pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(502,"Bad Gateway","Envoi du mail de vérification impossible.",req) }
    }
    let payload = "{\"id\":" + json_texte(id) + ",\"email\":" + json_texte(unwrap_or(email, "")) + ",\"name\":" + json_texte(unwrap_or(nom, "")) + "}"
    pg_liberer(sortie); pg_fermer(unwrap_or(conn, ptr_null()))
    return WebResultat.WebOk(reponse_json(payload))
}

fn api_verify_email(req: Requete, _params: Map<Text>) -> WebResultat {
    var token = champ_entree(req,"token")
    if not has(token) { let query = requete_query(req,"token"); if has(query) { token = query } }
    if not has(token) { return erreur_json(422,"Unprocessable Content","token obligatoire.",req) }
    let hash = hmac_sha256_hex(bytes_from_text(unwrap_or(env("NOLIAE_SESSION_SECRET"),"")), bytes_from_text(unwrap_or(token,"")))
    let conn = db()
    if not has(conn) { return erreur_json(503,"Service Unavailable","Base PostgreSQL indisponible.",req) }
    let res = pg_requete_params(unwrap_or(conn,ptr_null()), "UPDATE users SET email_verified=true WHERE id=(SELECT user_id FROM email_verification_tokens WHERE token_hash=$1 AND used_at IS NULL AND expires_at>now()) RETURNING id", [hash])
    if has(res) and pg_lignes(unwrap_or(res,ptr_null())) == 1 {
        let done = pg_requete_params(unwrap_or(conn,ptr_null()), "UPDATE email_verification_tokens SET used_at=now() WHERE token_hash=$1", [hash])
        if has(done) { pg_liberer(unwrap_or(done,ptr_null())) }
        pg_liberer(unwrap_or(res,ptr_null())); pg_fermer(unwrap_or(conn,ptr_null())); return WebResultat.WebOk(reponse_json("{\"verified\":true}"))
    }
    if has(res) { pg_liberer(unwrap_or(res,ptr_null())) }; pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(400,"Bad Request","Token invalide ou expiré.",req)
}

// Extrait le texte réel de la réponse d'un fournisseur IA depuis l'enveloppe
// renvoyée par NolCore-IA ({"provider":..,"result":"<JSON brut échappé>",...}).
// Sans cette extraction, on renverrait/stockerait l'enveloppe JSON brute au
// lieu du texte lisible attendu par l'utilisateur.
fn ia_reponse_texte(enveloppe: Text, provider: Text) -> Text {
    let raw = unwrap_or(json_texte_champ(enveloppe, "result"), enveloppe)
    if provider == "claude" {
        return unwrap_or(json_chemin_texte(raw, "content.0.text"), raw)
    }
    if provider == "gemini" {
        return unwrap_or(json_chemin_texte(raw, "candidates.0.content.parts.0.text"), raw)
    }
    // chatgpt / openai / mistral (et fournisseurs compatibles Chat Completions)
    return unwrap_or(json_chemin_texte(raw, "choices.0.message.content"), raw)
}
fn api_chat(req: Requete, _params: Map<Text>) -> WebResultat {
    let secret = unwrap_or(env("NOLIAE_SESSION_SECRET"), "")
    let id = utilisateur(req, secret)
    if not has(id) { return erreur_json(401, "Unauthorized", "Bearer Nolc requis.", req) }
    let corps = requete_json(req)
    if not has(corps) { return erreur_json(400, "Bad Request", "JSON invalide.", req) }
    let message = json_texte_champ(unwrap_or(corps, ""), "message")
    if not has(message) { return erreur_json(422, "Unprocessable Content", "message est obligatoire.", req) }
    let conn = db()
    if not has(conn) { return erreur_json(503, "Service Unavailable", "Base PostgreSQL indisponible.", req) }
    let fournisseur = unwrap_or(json_texte_champ(unwrap_or(corps,""),"provider"),unwrap_or(env("NOLCORE_DEFAULT_PROVIDER"), "chatgpt"))
    let modele = unwrap_or(json_texte_champ(unwrap_or(corps,""),"model"),unwrap_or(env("NOLCORE_DEFAULT_MODEL"), "gpt-4o-mini"))
    let quota = unwrap_or(parse_int(unwrap_or(env("NOLCORE_AI_HOURLY_LIMIT"),"40")),40)
    let usage = pg_requete_params(unwrap_or(conn,ptr_null()),"SELECT count(*) FROM ai_usage WHERE user_id=$1 AND created_at > now()-interval '1 hour'",[unwrap_or(id,"")])
    if has(usage) and unwrap_or(parse_int(unwrap_or(pg_valeur(unwrap_or(usage,ptr_null()),0,0),"0")),0) >= quota { pg_liberer(unwrap_or(usage,ptr_null())); pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(429,"Too Many Requests","Quota IA horaire atteint.",req) }
    if has(usage) { pg_liberer(unwrap_or(usage,ptr_null())) }
    // conv_public est le public_id (UUID) exposé au client (URL /chat/:id) ;
    // conv_internal est le BIGINT interne, seul utilisable pour les FK
    // messages.conversation_id / ai_usage.conversation_id.
    var conv_public = unwrap_or(json_texte_champ(unwrap_or(corps,""),"conversation_id"),"")
    let conv_est_nouvelle = conv_public == ""
    var conv_internal = ""
    if conv_public == "" {
        var titre = unwrap_or(message, ""); if len(titre) > 80 { titre = sub(titre, 0, 80) }
        let conversation = pg_requete_params(unwrap_or(conn, ptr_null()), "INSERT INTO conversations(id,\"userId\",title,\"updatedAt\") VALUES(gen_random_uuid()::text,$1,$2,now()) RETURNING id,id", [unwrap_or(id,""), titre])
        if not has(conversation) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(500,"Internal Server Error","Création de conversation impossible.",req) }
        let conv = unwrap_or(conversation, ptr_null()); conv_internal = unwrap_or(pg_valeur(conv,0,0),""); conv_public = unwrap_or(pg_valeur(conv,0,1),""); pg_liberer(conv)
    } else if not est_uuid(conv_public) {
        pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(404,"Not Found","Conversation introuvable.",req)
    } else {
        let owned = pg_requete_params(unwrap_or(conn,ptr_null()),"SELECT id FROM conversations WHERE id=$1 AND \"userId\"=$2",[conv_public,unwrap_or(id,"")])
        if not has(owned) or pg_lignes(unwrap_or(owned,ptr_null())) != 1 { if has(owned) { pg_liberer(unwrap_or(owned,ptr_null())) }; pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(404,"Not Found","Conversation introuvable.",req) }
        conv_internal = unwrap_or(pg_valeur(unwrap_or(owned,ptr_null()),0,0),"")
        pg_liberer(unwrap_or(owned,ptr_null()))
    }
    let saved = pg_requete_params(unwrap_or(conn, ptr_null()), "INSERT INTO messages(\"conversationId\",role,content) VALUES($1,'user',$2)", [conv_internal, unwrap_or(message,"")])
    if has(saved) { pg_liberer(unwrap_or(saved,ptr_null())) }
    let rag = pg_requete_params(unwrap_or(conn,ptr_null()),"SELECT title,content FROM documents WHERE owner_id=$1 AND search_vector @@ plainto_tsquery('french',$2) ORDER BY ts_rank(search_vector,plainto_tsquery('french',$2)) DESC LIMIT 3",[unwrap_or(id,""),unwrap_or(message,"")])
    var contexte = ""
    if has(rag) { let sources = unwrap_or(rag,ptr_null()); var ri=0; while ri < pg_lignes(sources) { contexte += "\n[" + unwrap_or(pg_valeur(sources,ri,0),"") + "] " + sub(unwrap_or(pg_valeur(sources,ri,1),""),0,1200); ri=ri+1 }; pg_liberer(sources) }
    let service_url = unwrap_or(env("NOLCORE_IA_URL"), "")
    if service_url == "" { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(503,"Service Unavailable","Service IA non configuré.",req) }
    let body = "{\"provider\":" + json_texte(fournisseur) + ",\"model\":" + json_texte(modele) + ",\"text\":" + json_texte(unwrap_or(message,"") + contexte) + "}"
    let ia = http_post(service_url + "/v1/ia", "application/json", body)
    if not has(ia) or unwrap_or(ia,ReponseHttp { statut:0, entetes:"", corps:"" }).statut >= 300 { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(502,"Bad Gateway","Service IA indisponible.",req) }
    let enveloppe = unwrap_or(ia,ReponseHttp { statut:0, entetes:"", corps:"" }).corps
    // « enveloppe » est {"provider":..,"result":"<JSON brut du fournisseur, échappé>",...} :
    // il faut décoder "result" PUIS en extraire le texte réel de la réponse
    // (jamais renvoyer/stocker l'enveloppe brute telle quelle).
    let answer = ia_reponse_texte(enveloppe, fournisseur)
    let saved_answer = pg_requete_params(unwrap_or(conn, ptr_null()), "INSERT INTO messages(\"conversationId\",role,content) VALUES($1,'assistant',$2)", [conv_internal, answer])
    if has(saved_answer) { pg_liberer(unwrap_or(saved_answer,ptr_null())) }
    let input_tokens = unwrap_or(json_chemin_int(enveloppe,"input_tokens"),0)
    let output_tokens = unwrap_or(json_chemin_int(enveloppe,"output_tokens"),0)
    let estimated_cost = unwrap_or(json_chemin_int(enveloppe,"estimated_cost_micros"),0)
    let cost = pg_requete_params(unwrap_or(conn,ptr_null()),"INSERT INTO ai_usage(user_id,conversation_id,provider,model,input_chars,output_chars,estimated_cost_micros) VALUES($1,$2,$3,$4,$5,$6,$7)",[unwrap_or(id,""),conv_internal,fournisseur,modele,text(input_tokens),text(output_tokens),text(estimated_cost)])
    if has(cost) { pg_liberer(unwrap_or(cost,ptr_null())) }
    pg_fermer(unwrap_or(conn, ptr_null()))
    // Le nouveau message rend le cache de cette conversation (et, si elle
    // vient d'être créée, la liste des conversations) périmé immédiatement.
    cache_del("convmsgs:" + conv_public + ":" + unwrap_or(id,""))
    if conv_est_nouvelle { cache_del("convs:" + unwrap_or(id,"")) }
    return WebResultat.WebOk(reponse_json("{\"conversation_id\":" + json_texte(conv_public) + ",\"answer\":" + json_texte(answer) + "}"))
}

// Historique des conversations IA : liste (sidebar), messages d'une
// conversation, suppression. Les messages sont déjà persistés par
// api_chat ; ces routes permettent simplement de les relire/gérer.
fn api_conversations(req: Requete, _params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401, "Unauthorized", "Authentification requise.", req) }
    // Liste re-demandée à chaque frappe/ouverture de la sidebar : un TTL
    // court suffit à éviter l'aller-retour PostgreSQL systématique sans
    // risquer un affichage périmé longtemps (invalidée de toute façon dès
    // qu'une conversation est créée/supprimée, voir cache_del ci-dessous).
    let cache_key_convs = "convs:" + unwrap_or(id,"")
    let cached_convs = cache_get(cache_key_convs)
    if has(cached_convs) { return WebResultat.WebOk(reponse_json(unwrap_or(cached_convs,"[]"))) }
    let conn = db()
    if not has(conn) { return erreur_json(503, "Service Unavailable", "Base PostgreSQL indisponible.", req) }
    let res = pg_requete_params(unwrap_or(conn,ptr_null()), "SELECT id,title,NULL,NULL,\"createdAt\" FROM conversations WHERE \"userId\"=$1 ORDER BY \"createdAt\" DESC LIMIT 100", [unwrap_or(id,"")])
    if not has(res) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(500,"Internal Server Error","Historique indisponible.",req) }
    let sortie = unwrap_or(res,ptr_null())
    var items = "["
    var i = 0
    while i < pg_lignes(sortie) {
        if i > 0 { items += "," }
        items += "{\"id\":" + json_texte(unwrap_or(pg_valeur(sortie,i,0),"")) + ",\"title\":" + json_texte(unwrap_or(pg_valeur(sortie,i,1),"")) + ",\"provider\":" + json_texte(unwrap_or(pg_valeur(sortie,i,2),"")) + ",\"model\":" + json_texte(unwrap_or(pg_valeur(sortie,i,3),"")) + ",\"created_at\":" + json_texte(unwrap_or(pg_valeur(sortie,i,4),"")) + "}"
        i = i + 1
    }
    items += "]"
    pg_liberer(sortie); pg_fermer(unwrap_or(conn,ptr_null()))
    cache_set(cache_key_convs, 20, items)
    return WebResultat.WebOk(reponse_json(items))
}

fn api_conversation_messages(req: Requete, params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401, "Unauthorized", "Authentification requise.", req) }
    let conv_id = parametre(params, "id")
    if not est_uuid(conv_id) { return erreur_json(404, "Not Found", "Conversation introuvable.", req) }
    // Contenu d'une conversation entière : quasi jamais modifié après coup
    // (sauf nouveau message, qui invalide explicitement cette clé), donc un
    // cache Redis évite de re-payer la jointure PostgreSQL à chaque
    // ouverture/refresh — c'est ce qui rendait la réouverture perceptiblement
    // lente même pour une conversation de quelques lignes.
    let cache_key_msgs = "convmsgs:" + conv_id + ":" + unwrap_or(id,"")
    let cached_msgs = cache_get(cache_key_msgs)
    if has(cached_msgs) { return WebResultat.WebOk(reponse_json(unwrap_or(cached_msgs,"[]"))) }
    let conn = db()
    if not has(conn) { return erreur_json(503, "Service Unavailable", "Base PostgreSQL indisponible.", req) }
    let db_conn = unwrap_or(conn,ptr_null())
    // La jointure sur user_id garantit qu'un utilisateur ne peut lire que ses
    // propres conversations, même en devinant un autre id numérique.
    let res = pg_requete_params(db_conn, "SELECT m.role,m.content,m.\"createdAt\" FROM messages m JOIN conversations c ON c.id=m.\"conversationId\" WHERE c.id=$1 AND c.\"userId\"=$2 ORDER BY m.\"createdAt\" ASC", [conv_id, unwrap_or(id,"")])
    if not has(res) { pg_fermer(db_conn); return erreur_json(500,"Internal Server Error","Messages indisponibles.",req) }
    let sortie = unwrap_or(res,ptr_null())
    if pg_lignes(sortie) == 0 {
        // Distingue "conversation vide" de "conversation inexistante/pas la vôtre".
        let owned = pg_requete_params(db_conn, "SELECT id FROM conversations WHERE id=$1 AND \"userId\"=$2", [conv_id, unwrap_or(id,"")])
        let existe = has(owned) and pg_lignes(unwrap_or(owned,ptr_null())) == 1
        if has(owned) { pg_liberer(unwrap_or(owned,ptr_null())) }
        if not existe { pg_liberer(sortie); pg_fermer(db_conn); return erreur_json(404,"Not Found","Conversation introuvable.",req) }
    }
    var items = "["
    var i = 0
    while i < pg_lignes(sortie) {
        if i > 0 { items += "," }
        items += "{\"role\":" + json_texte(unwrap_or(pg_valeur(sortie,i,0),"")) + ",\"content\":" + json_texte(unwrap_or(pg_valeur(sortie,i,1),"")) + ",\"created_at\":" + json_texte(unwrap_or(pg_valeur(sortie,i,2),"")) + "}"
        i = i + 1
    }
    items += "]"
    pg_liberer(sortie); pg_fermer(db_conn)
    cache_set(cache_key_msgs, 60, items)
    return WebResultat.WebOk(reponse_json(items))
}

fn api_conversation_supprimer(req: Requete, params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401, "Unauthorized", "Authentification requise.", req) }
    let conv_id = parametre(params, "id")
    if not est_uuid(conv_id) { return erreur_json(404, "Not Found", "Conversation introuvable.", req) }
    let conn = db()
    if not has(conn) { return erreur_json(503, "Service Unavailable", "Base PostgreSQL indisponible.", req) }
    let db_conn = unwrap_or(conn,ptr_null())
    let res = pg_requete_params(db_conn, "DELETE FROM conversations WHERE id=$1 AND \"userId\"=$2 RETURNING id", [conv_id, unwrap_or(id,"")])
    if not has(res) { pg_fermer(db_conn); return erreur_json(500,"Internal Server Error","Suppression impossible.",req) }
    let supprime = pg_lignes(unwrap_or(res,ptr_null())) == 1
    pg_liberer(unwrap_or(res,ptr_null())); pg_fermer(db_conn)
    if not supprime { return erreur_json(404,"Not Found","Conversation introuvable.",req) }
    cache_del("convmsgs:" + conv_id + ":" + unwrap_or(id,""))
    cache_del("convs:" + unwrap_or(id,""))
    return WebResultat.WebOk(reponse_json("{\"deleted\":true}"))
}

// Partage public : bascule is_public, réservé au propriétaire. Le lien
// partagé réutilise directement public_id (déjà un UUID imprévisible) comme
// jeton — pas besoin d'un second secret, juste du flag qui autorise la
// lecture SANS authentification.
fn api_conversation_partager(req: Requete, params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401, "Unauthorized", "Authentification requise.", req) }
    let conv_id = parametre(params, "id")
    if not est_uuid(conv_id) { return erreur_json(404, "Not Found", "Conversation introuvable.", req) }
    let conn = db()
    if not has(conn) { return erreur_json(503, "Service Unavailable", "Base PostgreSQL indisponible.", req) }
    let db_conn = unwrap_or(conn,ptr_null())
    let res = pg_requete_params(db_conn, "UPDATE conversations SET is_public=true WHERE public_id=$1::uuid AND user_id=$2 RETURNING public_id", [conv_id, unwrap_or(id,"")])
    if not has(res) { pg_fermer(db_conn); return erreur_json(500,"Internal Server Error","Partage impossible.",req) }
    let ok = pg_lignes(unwrap_or(res,ptr_null())) == 1
    pg_liberer(unwrap_or(res,ptr_null())); pg_fermer(db_conn)
    if not ok { return erreur_json(404,"Not Found","Conversation introuvable.",req) }
    return WebResultat.WebOk(reponse_json("{\"shared\":true,\"id\":" + json_texte(conv_id) + "}"))
}
fn api_conversation_departager(req: Requete, params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401, "Unauthorized", "Authentification requise.", req) }
    let conv_id = parametre(params, "id")
    if not est_uuid(conv_id) { return erreur_json(404, "Not Found", "Conversation introuvable.", req) }
    let conn = db()
    if not has(conn) { return erreur_json(503, "Service Unavailable", "Base PostgreSQL indisponible.", req) }
    let db_conn = unwrap_or(conn,ptr_null())
    let res = pg_requete_params(db_conn, "UPDATE conversations SET is_public=false WHERE public_id=$1::uuid AND user_id=$2 RETURNING public_id", [conv_id, unwrap_or(id,"")])
    if not has(res) { pg_fermer(db_conn); return erreur_json(500,"Internal Server Error","Retrait du partage impossible.",req) }
    let ok = pg_lignes(unwrap_or(res,ptr_null())) == 1
    pg_liberer(unwrap_or(res,ptr_null())); pg_fermer(db_conn)
    if not ok { return erreur_json(404,"Not Found","Conversation introuvable.",req) }
    return WebResultat.WebOk(reponse_json("{\"shared\":false}"))
}
// Lecture publique SANS authentification : uniquement si is_public=true.
// N'expose ni user_id, ni email, ni rien d'autre que titre/messages —
// c'est un instantané en lecture seule, pas un accès à la conversation.
fn api_conversation_publique(req: Requete, params: Map<Text>) -> WebResultat {
    let conv_id = parametre(params, "id")
    if not est_uuid(conv_id) { return erreur_json(404, "Not Found", "Conversation introuvable.", req) }
    let conn = db()
    if not has(conn) { return erreur_json(503, "Service Unavailable", "Base PostgreSQL indisponible.", req) }
    let db_conn = unwrap_or(conn,ptr_null())
    let conv = pg_requete_params(db_conn, "SELECT id,title,provider,model FROM conversations WHERE public_id=$1::uuid AND is_public=true", [conv_id])
    if not has(conv) or pg_lignes(unwrap_or(conv,ptr_null())) != 1 { if has(conv) { pg_liberer(unwrap_or(conv,ptr_null())) }; pg_fermer(db_conn); return erreur_json(404,"Not Found","Conversation introuvable ou non partagée.",req) }
    let c = unwrap_or(conv,ptr_null())
    let internal_id = unwrap_or(pg_valeur(c,0,0),"")
    let titre = unwrap_or(pg_valeur(c,0,1),"")
    let provider = unwrap_or(pg_valeur(c,0,2),"")
    let modele = unwrap_or(pg_valeur(c,0,3),"")
    pg_liberer(c)
    let res = pg_requete_params(db_conn, "SELECT role,content,created_at FROM messages WHERE conversation_id=$1 ORDER BY id ASC", [internal_id])
    if not has(res) { pg_fermer(db_conn); return erreur_json(500,"Internal Server Error","Messages indisponibles.",req) }
    let sortie = unwrap_or(res,ptr_null())
    var items = "["
    var i = 0
    while i < pg_lignes(sortie) {
        if i > 0 { items += "," }
        items += "{\"role\":" + json_texte(unwrap_or(pg_valeur(sortie,i,0),"")) + ",\"content\":" + json_texte(unwrap_or(pg_valeur(sortie,i,1),"")) + ",\"created_at\":" + json_texte(unwrap_or(pg_valeur(sortie,i,2),"")) + "}"
        i = i + 1
    }
    items += "]"
    pg_liberer(sortie); pg_fermer(db_conn)
    return WebResultat.WebOk(reponse_json("{\"title\":" + json_texte(titre) + ",\"provider\":" + json_texte(provider) + ",\"model\":" + json_texte(modele) + ",\"messages\":" + items + "}"))
}

// Extension sûre pour un content-type image whitelisté (jamais dérivée du nom
// de fichier client : évite qu'un ".php"/chemin quelconque se retrouve dans
// la clé S3). Vide = type non supporté -> upload refusé.
fn s3_extension_image(content_type: Text) -> Text {
    let ct = lower(content_type)
    if ct == "image/png" { return "png" }
    if ct == "image/jpeg" or ct == "image/jpg" { return "jpg" }
    if ct == "image/webp" { return "webp" }
    if ct == "image/gif" { return "gif" }
    return ""
}

// Présigne une URL de dépôt S3 pour une image que le NAVIGATEUR uploade
// directement (voir s3.nol pour le pourquoi). Ne touche jamais aux octets de
// l'image : ce endpoint ne fait QUE signer une URL, aucune donnée binaire ne
// transite par ce serveur.
fn api_upload_presign(req: Requete, _params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401, "Unauthorized", "Authentification requise.", req) }
    let conf = s3_conf()
    if not has(conf) { return erreur_json(503, "Service Unavailable", "Stockage d'images non configuré.", req) }
    let rl = redis_rate_ok("upload:" + unwrap_or(id,""), 20, 3600)
    if has(rl) and not unwrap_or(rl,true) { return erreur_json(429,"Too Many Requests","Trop d'imports d'images cette heure.",req) }
    let corps = requete_json(req)
    if not has(corps) { return erreur_json(400, "Bad Request", "JSON invalide.", req) }
    let content_type = unwrap_or(json_texte_champ(unwrap_or(corps,""),"content_type"),"")
    let ext = s3_extension_image(content_type)
    if ext == "" { return erreur_json(422, "Unprocessable Content", "Type d'image non supporté (png, jpg, webp, gif).", req) }
    let nom = unwrap_or(random_hex(16), "")
    if nom == "" { return erreur_json(500,"Internal Server Error","Génération de clé impossible.",req) }
    let cle = "chat-uploads/" + unwrap_or(id,"") + "/" + nom + "." + ext
    let c = unwrap_or(conf, ConfS3 { hote:"", region_:"", bucket:"", acces:"", secret:"" })
    let d = epoch_vers_date(maintenant_epoch())
    let upload_url = s3_presigner_put(c, cle, 300, d)
    let public_url = s3_url_publique(c, cle)
    return WebResultat.WebOk(reponse_json("{\"upload_url\":" + json_texte(upload_url) + ",\"public_url\":" + json_texte(public_url) + ",\"key\":" + json_texte(cle) + "}"))
}

fn api_login(req: Requete, _params: Map<Text>) -> WebResultat {
    let email = champ_entree(req, "email")
    let mot = champ_entree(req, "password")
    if not has(email) or not has(mot) { return erreur_json(422, "Unprocessable Content", "email et password sont obligatoires.", req) }
    // Anti brute-force : clé sur l'e-mail tenté (le WAF ne transmet PAS
    // l'IP client, donc une clé par IP serait inefficace ici — voir aussi
    // redis_rate_ok). Fail-open si Redis est indisponible (la robustesse du
    // hash + la 2FA restent la vraie défense) ; sinon 10 tentatives / 5 min.
    let rl_login = redis_rate_ok("login:" + lower(trim(unwrap_or(email, ""))), 10, 300)
    if has(rl_login) and not unwrap_or(rl_login, true) { return erreur_json(429, "Too Many Requests", "Trop de tentatives de connexion, réessayez dans quelques minutes.", req) }
    let conn = db()
    if not has(conn) { return erreur_json(503, "Service Unavailable", "Base PostgreSQL indisponible.", req) }
    let res = pg_requete_params(unwrap_or(conn, ptr_null()), "SELECT id,email,name,\"passwordHash\",'user',true,NULL,false FROM users WHERE email=$1", [unwrap_or(email, "")])
    if not has(res) { pg_fermer(unwrap_or(conn, ptr_null())); return erreur_json(401, "Unauthorized", "Identifiants invalides.", req) }
    let sortie = unwrap_or(res, ptr_null())
    if pg_lignes(sortie) != 1 { pg_liberer(sortie); pg_fermer(unwrap_or(conn, ptr_null())); return erreur_json(401, "Unauthorized", "Identifiants invalides.", req) }
    let hash = unwrap_or(pg_valeur(sortie, 0, 3), "")
    let valide = mot_de_passe_verifie(hash, bytes_from_text(unwrap_or(mot, "")))
    if not valide { pg_liberer(sortie); pg_fermer(unwrap_or(conn, ptr_null())); return erreur_json(401, "Unauthorized", "Identifiants invalides.", req) }
    let verifie = unwrap_or(pg_valeur(sortie,0,5),"false")
    if verifie != "true" and verifie != "t" { pg_liberer(sortie); pg_fermer(unwrap_or(conn, ptr_null())); return erreur_json(403,"Forbidden","Adresse e-mail non vérifiée.",req) }
    // MFA : si le TOTP est activé, exiger un code valide (champ « otp »).
    let totp_on = unwrap_or(pg_valeur(sortie, 0, 7), "false")
    if totp_on == "true" or totp_on == "t" {
        let otp = champ_entree(req, "otp")
        let secret_totp = unwrap_or(pg_valeur(sortie, 0, 6), "")
        if not has(otp) { pg_liberer(sortie); pg_fermer(unwrap_or(conn, ptr_null())); return erreur_json(401, "MFA Required", "Code d'authentification à deux facteurs requis.", req) }
        if not totp_verifie(secret_totp, unwrap_or(otp, ""), maintenant_epoch()) { pg_liberer(sortie); pg_fermer(unwrap_or(conn, ptr_null())); return erreur_json(401, "Unauthorized", "Code MFA invalide.", req) }
    }
    let id = unwrap_or(pg_valeur(sortie, 0, 0), "")
    let token = session_signe(unwrap_or(env("NOLIAE_SESSION_SECRET"), ""), id, 86400, maintenant_epoch())
    let cookie = cookie_session(unwrap_or(env("NOLIAE_SESSION_SECRET"), ""), unwrap_or(email,""), ip_requete(req))
    if has(cookie) {
        let cookie_hash = hmac_sha256_hex(bytes_from_text(unwrap_or(env("NOLIAE_SESSION_SECRET"), "")), bytes_from_text(unwrap_or(cookie,"")))
        let session_id = random_hex(16)
        if has(session_id) {
            let bearer_hash = hmac_sha256_hex(bytes_from_text(unwrap_or(env("NOLIAE_SESSION_SECRET"), "")), bytes_from_text(unwrap_or(token,"")))
            let saved_session = pg_requete_params(unwrap_or(conn,ptr_null()), "INSERT INTO user_sessions(session_id,token_hash,bearer_token_hash,user_id,email,ip,user_agent,expires_at) VALUES($1,$2,$3,$4,$5,$6,$7,now()+interval '24 hours')", [unwrap_or(session_id,""),cookie_hash,bearer_hash,id,unwrap_or(email,""),ip_requete(req),unwrap_or(requete_entete(req,"User-Agent"),"")])
            if has(saved_session) { pg_liberer(unwrap_or(saved_session,ptr_null())) }
        }
    }
    pg_liberer(sortie); pg_fermer(unwrap_or(conn, ptr_null()))
    if not has(token) { return erreur_json(500, "Internal Server Error", "Session indisponible.", req) }
    var rep = reponse_json("{\"token\":" + json_texte(unwrap_or(token, "")) + ",\"user_id\":" + json_texte(id) + "}")
    if has(cookie) { rep = reponse_cookie_domaine(rep, "nol_session", unwrap_or(cookie,""), 86400, true, lower(unwrap_or(env("NOLIAE_COOKIE_SECURE"),"false")) == "true", "Lax", unwrap_or(env("NOLIAE_COOKIE_DOMAIN"),"")) }
    return WebResultat.WebOk(rep)
}

// Limitation de débit DISTRIBUÉE via Redis (partagée entre répliques).
// Retourne none si Redis est indisponible (l'appelant retombe alors sur le
// comptage PostgreSQL), some(true) si sous la limite, some(false) si dépassée.
fn redis_rate_ok(cle: Text, limite: Int, fenetre: Int) -> Option<Bool> {
    let oc = redis_env()
    if not has(oc) { return none }
    let fd = unwrap_or(oc, -1)
    let n = redis_incr(fd, "rl:" + cle)
    var res: Option<Bool> = none
    if has(n) {
        if unwrap_or(n, 0) == 1 { let _e = redis_expire(fd, "rl:" + cle, fenetre) }
        res = some(unwrap_or(n, 0) <= limite)
    }
    redis_fermer(fd)
    return res
}

// Cache de recherche partagé (lecture). none = absent, désactivé ou erreur.
fn cache_get(cle: Text) -> Option<Text> {
    let oc = redis_env()
    if not has(oc) { return none }
    let fd = unwrap_or(oc, -1)
    let v = redis_get(fd, "sc:" + cle)
    redis_fermer(fd)
    return v
}

// Cache de recherche partagé (écriture, best-effort).
fn cache_set(cle: Text, ttl: Int, valeur: Text) {
    let oc = redis_env()
    if not has(oc) { return }
    let fd = unwrap_or(oc, -1)
    let _s = redis_setex(fd, "sc:" + cle, ttl, valeur)
    redis_fermer(fd)
}
// Invalidation best-effort (best-effort aussi si Redis est down : le TTL
// court de cache_set couvre alors le pire cas).
fn cache_del(cle: Text) {
    let oc = redis_env()
    if not has(oc) { return }
    let fd = unwrap_or(oc, -1)
    let _d = redis_del(fd, "sc:" + cle)
    redis_fermer(fd)
}

fn api_search(req: Requete, _params: Map<Text>) -> WebResultat {
    let secret = unwrap_or(env("NOLIAE_SESSION_SECRET"), "")
    let id = utilisateur(req, secret)
    // La recherche publique (index crawler + repli Brave) ne nécessite PAS de
    // compte : seuls les documents PRIVÉS d'un utilisateur exigent une
    // session. Un visiteur anonyme reçoit donc directement les résultats
    // publics, sans jamais toucher à la table documents (owner_id).
    let q = requete_query(req, "q")
    if not has(q) or len(unwrap_or(q, "")) < 2 { return erreur_json(422, "Unprocessable Content", "q doit contenir au moins 2 caractères.", req) }
    var page = unwrap_or(parse_int(unwrap_or(requete_query(req,"page"),"1")),1)
    var limit = unwrap_or(parse_int(unwrap_or(requete_query(req,"limit"),"20")),20)
    if page < 1 { page = 1 }; if page > 100 { page = 100 }
    if limit < 1 { limit = 1 }; if limit > 50 { limit = 50 }
    let offset = (page - 1) * limit
    let conn = db()
    if not has(conn) { return erreur_json(503, "Service Unavailable", "Base PostgreSQL indisponible.", req) }
    // Débit par utilisateur réel si connecté ; sinon par IP (le WAF transmet
    // désormais la vraie IP client dans X-Forwarded-For, plus un en-tête
    // usurpable par le client comme avant sa correction).
    let cle_rate = unwrap_or(id, "anon:" + unwrap_or(requete_entete(req, "X-Forwarded-For"), "anonymous"))
    // Anti-abus DISTRIBUÉ via Redis (partagé entre répliques), avec repli sur
    // le comptage PostgreSQL si Redis est indisponible (fail-open).
    let rl = redis_rate_ok("search:" + cle_rate, 60, 60)
    if has(rl) {
        if not unwrap_or(rl, true) { pg_fermer(unwrap_or(conn, ptr_null())); return erreur_json(429, "Too Many Requests", "Limite de recherche atteinte, réessayez dans une minute.", req) }
    } else {
        let rate = pg_requete_params(unwrap_or(conn, ptr_null()), "SELECT count(*) FROM audit_logs WHERE action='search' AND metadata->>'key'=$1 AND created_at > now() - interval '1 minute'", [cle_rate])
        if has(rate) and unwrap_or(parse_int(unwrap_or(pg_valeur(unwrap_or(rate,ptr_null()),0,0),"0")),0) >= 60 { pg_liberer(unwrap_or(rate,ptr_null())); pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(429,"Too Many Requests","Limite de recherche atteinte, réessayez dans une minute.",req) }
        if has(rate) { pg_liberer(unwrap_or(rate,ptr_null())) }
    }
    // Cache de recherche partagé : clé par (utilisateur, page, limite, requête).
    let cle_cache = unwrap_or(id, "") + ":" + text(page) + ":" + text(limit) + ":" + sub(sha256_hex(bytes_from_text(unwrap_or(q, ""))), 0, 16)
    let cached = cache_get(cle_cache)
    if has(cached) {
        pg_fermer(unwrap_or(conn, ptr_null()))
        return WebResultat.WebOk(reponse_avec_entete(reponse_json(unwrap_or(cached, "[]")), "X-Cache", "HIT"))
    }
    var items = "[]"
    var lignes_privees = 0
    if has(id) {
        let res = pg_requete_params(unwrap_or(conn, ptr_null()), "SELECT id,title,content, count(*) OVER() AS total FROM documents WHERE owner_id=$1 AND search_vector @@ plainto_tsquery('french',$2) ORDER BY ts_rank_cd(search_vector, plainto_tsquery('french',$2)) DESC LIMIT $3 OFFSET $4", [unwrap_or(id, ""), unwrap_or(q, ""),text(limit),text(offset)])
        if not has(res) { pg_fermer(unwrap_or(conn, ptr_null())); return erreur_json(500, "Internal Server Error", "Recherche indisponible.", req) }
        let sortie = unwrap_or(res, ptr_null())
        items = "["
        var i = 0
        while i < pg_lignes(sortie) {
            if i > 0 { items = items + "," }
            items = items + "{\"id\":" + json_texte(unwrap_or(pg_valeur(sortie, i, 0), "")) + ",\"url\":\"\",\"title\":" + json_texte(unwrap_or(pg_valeur(sortie, i, 1), "")) + ",\"content\":" + json_texte(unwrap_or(pg_valeur(sortie, i, 2), "")) + ",\"source\":\"private\"}"
            i = i + 1
        }
        items = items + "]"
        lignes_privees = pg_lignes(sortie)
        var total_priv = 0
        if lignes_privees > 0 { total_priv = unwrap_or(parse_int(unwrap_or(pg_valeur(sortie, 0, 3), "0")), 0) }
        pg_liberer(sortie)
        if lignes_privees > 0 {
            let _audit = pg_requete_params(unwrap_or(conn, ptr_null()), "INSERT INTO audit_logs(user_id,action,resource,metadata) VALUES($1,'search','documents',jsonb_build_object('key',$2))", [unwrap_or(id,""), cle_rate])
            if has(_audit) { pg_liberer(unwrap_or(_audit,ptr_null())) }
            if items != "[]" { cache_set(cle_cache, 30, items) }
            var tp_priv = 0
            if limit > 0 { tp_priv = (total_priv + limit - 1) / limit }
            var rep_priv = reponse_avec_entete(reponse_json(items), "X-Cache", "MISS")
            rep_priv = reponse_avec_entete(rep_priv, "X-Total-Count", text(total_priv))
            rep_priv = reponse_avec_entete(rep_priv, "X-Total-Pages", text(tp_priv))
            pg_fermer(unwrap_or(conn, ptr_null()))
            return WebResultat.WebOk(rep_priv)
        }
    }
    // Sans document privé (ou visiteur anonyme), consulter l'index public
    // construit par le crawler.
    // Classement = pertinence texte (ts_rank_cd) * autorité de lien (rang,
    // notre PageRank maison — voir pagerank.nol). Comme l'algorithme
    // originel de Google : le texte seul décide QUELS documents matchent,
    // mais parmi eux, ceux cités par des pages elles-mêmes autoritaires
    // remontent. `rang` vaut au moins 0.15/N (jamais 0), donc il pondère
    // sans jamais faire disparaître un document sans lien entrant connu.
    let public_res = pg_requete_params(unwrap_or(conn, ptr_null()), "SELECT url,title,description,image,content,'crawler' AS source, count(*) OVER() AS total FROM public_search_documents WHERE search_vector @@ plainto_tsquery('french',$1) ORDER BY ts_rank_cd(search_vector,plainto_tsquery('french',$1)) * rang DESC, crawled_at DESC LIMIT $2 OFFSET $3", [unwrap_or(q, ""),text(limit),text(offset)])
    if not has(public_res) { pg_fermer(unwrap_or(conn, ptr_null())); return erreur_json(500, "Internal Server Error", "Recherche indisponible.", req) }
    let public_sortie = unwrap_or(public_res, ptr_null())
    items = "["
    var i = 0
    while i < pg_lignes(public_sortie) {
        if i > 0 { items = items + "," }
        items = items + "{\"url\":" + json_texte(unwrap_or(pg_valeur(public_sortie, i, 0), "")) + ",\"title\":" + json_texte(unwrap_or(pg_valeur(public_sortie, i, 1), "")) + ",\"description\":" + json_texte(unwrap_or(pg_valeur(public_sortie, i, 2), "")) + ",\"image\":" + json_texte(unwrap_or(pg_valeur(public_sortie, i, 3), "")) + ",\"content\":" + json_texte(unwrap_or(pg_valeur(public_sortie, i, 4), "")) + ",\"source\":\"crawler\"}"
        i = i + 1
    }
    items = items + "]"
    var total_public = 0
    if pg_lignes(public_sortie) > 0 { total_public = unwrap_or(parse_int(unwrap_or(pg_valeur(public_sortie, 0, 6), "0")), 0) }
    // Premier passage : Brave répond tout de suite et ses URL sont mises
    // en file. Les passages suivants trouvent l'index local du crawler.
    if pg_lignes(public_sortie) == 0 {
        let brave_token = unwrap_or(env("NOLCORE_BRAVE_SEARCH_TOKEN"), "")
        if brave_token != "" {
        let brave = http_get_token("https://api.search.brave.com/res/v1/web/search?q=" + url_query_brave(unwrap_or(q,"")) + "&count=" + text(limit) + "&offset=" + text(offset) + "&country=FR&search_lang=fr", "X-Subscription-Token " + brave_token)
        if has(brave) and unwrap_or(brave, ReponseHttp { statut:0, entetes:"", corps:"" }).statut < 300 {
            let corps_brave = unwrap_or(brave, ReponseHttp { statut:0, entetes:"", corps:"{}" }).corps
            planifier_crawl_brave(unwrap_or(conn, ptr_null()), corps_brave)
            items = unwrap_or(json_chemin(corps_brave, "web.results"), "[]")
        } else { items = "[]" }
        } else { items = "[]" }
    }
    let _public_audit = pg_requete_params(unwrap_or(conn, ptr_null()), "INSERT INTO audit_logs(user_id,action,resource,metadata) VALUES($1,'search','public_search_documents',jsonb_build_object('key',$2))", [unwrap_or(id,""), cle_rate])
    if has(_public_audit) { pg_liberer(unwrap_or(_public_audit,ptr_null())) }
    if items != "[]" { cache_set(cle_cache, 30, items) }
    var tp_pub = 0
    if limit > 0 { tp_pub = (total_public + limit - 1) / limit }
    var rep_pub = reponse_avec_entete(reponse_json(items), "X-Cache", "MISS")
    rep_pub = reponse_avec_entete(rep_pub, "X-Total-Count", text(total_public))
    rep_pub = reponse_avec_entete(rep_pub, "X-Total-Pages", text(tp_pub))
    pg_liberer(public_sortie); pg_fermer(unwrap_or(conn, ptr_null()))
    return WebResultat.WebOk(rep_pub)
}

fn api_me(req: Requete, _params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401, "Unauthorized", "Authentification requise.", req) }
    let conn = db()
    if not has(conn) { return erreur_json(503, "Service Unavailable", "Base PostgreSQL indisponible.", req) }
    let res = pg_requete_params(unwrap_or(conn, ptr_null()), "SELECT id,email,name,'user','now' FROM users WHERE id=$1", [unwrap_or(id, "")])
    if not has(res) { pg_fermer(unwrap_or(conn, ptr_null())); return erreur_json(404, "Not Found", "Utilisateur introuvable.", req) }
    let sortie = unwrap_or(res, ptr_null())
    if pg_lignes(sortie) != 1 { pg_liberer(sortie); pg_fermer(unwrap_or(conn, ptr_null())); return erreur_json(404, "Not Found", "Utilisateur introuvable.", req) }
    let answer = "{\"id\":" + json_texte(unwrap_or(pg_valeur(sortie,0,0),"")) + ",\"email\":" + json_texte(unwrap_or(pg_valeur(sortie,0,1),"")) + ",\"name\":" + json_texte(unwrap_or(pg_valeur(sortie,0,2),"")) + ",\"role\":" + json_texte(unwrap_or(pg_valeur(sortie,0,3),"")) + "}"
    pg_liberer(sortie); pg_fermer(unwrap_or(conn, ptr_null()))
    return WebResultat.WebOk(reponse_json(answer))
}

// Inventaire minimal des appareils connectés. Les empreintes de token ne
// sortent jamais de PostgreSQL ; l'utilisateur ne voit que ses propres IP et
// dates d'expiration.
fn api_user_sessions(req: Requete, _params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401,"Unauthorized","Authentification requise.",req) }
    let conn = db(); if not has(conn) { return erreur_json(503,"Service Unavailable","Base PostgreSQL indisponible.",req) }
    let res = pg_requete_params(unwrap_or(conn,ptr_null()), "SELECT session_id,ip,issued_at,expires_at,user_agent FROM user_sessions WHERE user_id=$1 AND revoked=false AND expires_at>now() ORDER BY issued_at DESC LIMIT 100", [unwrap_or(id,"")])
    if not has(res) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(500,"Internal Server Error","Lecture des sessions impossible.",req) }
    let rows = unwrap_or(res,ptr_null()); var items = "["; var i = 0
    while i < pg_lignes(rows) {
        if i > 0 { items += "," }
        items += "{\"id\":" + json_texte(unwrap_or(pg_valeur(rows,i,0),"")) + ",\"ip\":" + json_texte(unwrap_or(pg_valeur(rows,i,1),"")) + ",\"issued_at\":" + json_texte(unwrap_or(pg_valeur(rows,i,2),"")) + ",\"expires_at\":" + json_texte(unwrap_or(pg_valeur(rows,i,3),"")) + ",\"user_agent\":" + json_texte(unwrap_or(pg_valeur(rows,i,4),"")) + "}"
        i = i + 1
    }
    pg_liberer(rows); pg_fermer(unwrap_or(conn,ptr_null()))
    return WebResultat.WebOk(reponse_json(items + "]"))
}

fn api_user_session_revoke(req: Requete, params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401,"Unauthorized","Authentification requise.",req) }
    let session_id = parametre(params,"session_id")
    if session_id == "" { return erreur_json(422,"Unprocessable Content","Identifiant de session obligatoire.",req) }
    let conn = db(); if not has(conn) { return erreur_json(503,"Service Unavailable","Base PostgreSQL indisponible.",req) }
    let changed = pg_requete_params(unwrap_or(conn,ptr_null()), "UPDATE user_sessions SET revoked=true WHERE session_id=$1 AND user_id=$2 AND revoked=false RETURNING session_id", [session_id,unwrap_or(id,"")])
    if not has(changed) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(500,"Internal Server Error","Révocation impossible.",req) }
    let rows = unwrap_or(changed,ptr_null()); let ok = pg_lignes(rows) == 1; pg_liberer(rows); pg_fermer(unwrap_or(conn,ptr_null()))
    if not ok { return erreur_json(404,"Not Found","Session introuvable.",req) }
    return WebResultat.WebOk(reponse_json("{\"revoked\":true}"))
}

fn api_user_sessions_revoke_all(req: Requete, _params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401,"Unauthorized","Authentification requise.",req) }
    let conn = db(); if not has(conn) { return erreur_json(503,"Service Unavailable","Base PostgreSQL indisponible.",req) }
    let changed = pg_requete_params(unwrap_or(conn,ptr_null()), "UPDATE user_sessions SET revoked=true WHERE user_id=$1 AND revoked=false", [unwrap_or(id,"")])
    if has(changed) { pg_liberer(unwrap_or(changed,ptr_null())) }
    pg_fermer(unwrap_or(conn,ptr_null()))
    return WebResultat.WebOk(reponse_json("{\"revoked\":true}"))
}

// ---------- MFA (TOTP) ----------

fn api_totp_setup(req: Requete, _params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401,"Unauthorized","Authentification requise.",req) }
    let conn = db(); if not has(conn) { return erreur_json(503,"Service Unavailable","Base PostgreSQL indisponible.",req) }
    let secret = totp_secret_nouveau()
    if secret == "" { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(500,"Internal Server Error","Génération du secret impossible.",req) }
    let em = pg_requete_params(unwrap_or(conn,ptr_null()), "UPDATE users SET totp_secret=$1, totp_enabled=false WHERE id=$2 RETURNING email", [secret, unwrap_or(id,"")])
    var email = "utilisateur"
    if has(em) { let r = unwrap_or(em,ptr_null()); if pg_lignes(r) == 1 { email = unwrap_or(pg_valeur(r,0,0),"utilisateur") } pg_liberer(r) }
    pg_fermer(unwrap_or(conn,ptr_null()))
    let uri = otpauth_uri(email, secret, unwrap_or(env("NOLCORE_MFA_ISSUER"),"NolCore"))
    return WebResultat.WebOk(reponse_json("{\"secret\":" + json_texte(secret) + ",\"otpauth\":" + json_texte(uri) + "}"))
}

fn api_totp_enable(req: Requete, _params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401,"Unauthorized","Authentification requise.",req) }
    let otp = champ_entree(req, "otp")
    if not has(otp) { return erreur_json(422,"Unprocessable Content","Code obligatoire.",req) }
    let conn = db(); if not has(conn) { return erreur_json(503,"Service Unavailable","Base PostgreSQL indisponible.",req) }
    let res = pg_requete_params(unwrap_or(conn,ptr_null()), "SELECT totp_secret FROM users WHERE id=$1", [unwrap_or(id,"")])
    if not has(res) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(500,"Internal Server Error","Lecture impossible.",req) }
    let r = unwrap_or(res,ptr_null()); let secret = unwrap_or(pg_valeur(r,0,0),""); pg_liberer(r)
    if secret == "" or not totp_verifie(secret, unwrap_or(otp,""), maintenant_epoch()) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(401,"Unauthorized","Code invalide.",req) }
    let up = pg_requete_params(unwrap_or(conn,ptr_null()), "UPDATE users SET totp_enabled=true WHERE id=$1", [unwrap_or(id,"")])
    if has(up) { pg_liberer(unwrap_or(up,ptr_null())) }
    pg_fermer(unwrap_or(conn,ptr_null()))
    return WebResultat.WebOk(reponse_json("{\"totp_enabled\":true}"))
}

fn api_totp_disable(req: Requete, _params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401,"Unauthorized","Authentification requise.",req) }
    let otp = champ_entree(req, "otp")
    let conn = db(); if not has(conn) { return erreur_json(503,"Service Unavailable","Base PostgreSQL indisponible.",req) }
    let res = pg_requete_params(unwrap_or(conn,ptr_null()), "SELECT totp_secret FROM users WHERE id=$1", [unwrap_or(id,"")])
    if not has(res) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(500,"Internal Server Error","Lecture impossible.",req) }
    let r = unwrap_or(res,ptr_null()); let secret = unwrap_or(pg_valeur(r,0,0),""); pg_liberer(r)
    if not has(otp) or not totp_verifie(secret, unwrap_or(otp,""), maintenant_epoch()) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(401,"Unauthorized","Code invalide.",req) }
    let up = pg_requete_params(unwrap_or(conn,ptr_null()), "UPDATE users SET totp_enabled=false, totp_secret='' WHERE id=$1", [unwrap_or(id,"")])
    if has(up) { pg_liberer(unwrap_or(up,ptr_null())) }
    pg_fermer(unwrap_or(conn,ptr_null()))
    return WebResultat.WebOk(reponse_json("{\"totp_enabled\":false}"))
}

// ---------- RGPD : export et suppression ----------

fn export_json_val(conn: Ptr<PgConn>, sql: Text, id: Text, defaut: Text) -> Text {
    let res = pg_requete_params(conn, sql, [id])
    if not has(res) { return defaut }
    let r = unwrap_or(res, ptr_null())
    var v = defaut
    if pg_lignes(r) == 1 { v = unwrap_or(pg_valeur(r, 0, 0), defaut) }
    pg_liberer(r)
    if v == "" { return defaut }
    return v
}

fn api_account_export(req: Requete, _params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401,"Unauthorized","Authentification requise.",req) }
    let conn = db(); if not has(conn) { return erreur_json(503,"Service Unavailable","Base PostgreSQL indisponible.",req) }
    let c = unwrap_or(conn, ptr_null())
    let cid = unwrap_or(id, "")
    let prof = export_json_val(c, "SELECT to_jsonb(u)-'password_hash'-'totp_secret' FROM users u WHERE id=$1", cid, "null")
    let conv = export_json_val(c, "SELECT coalesce(jsonb_agg(x),'[]') FROM conversations x WHERE user_id=$1", cid, "[]")
    let msgs = export_json_val(c, "SELECT coalesce(jsonb_agg(m),'[]') FROM messages m JOIN conversations x ON x.id=m.conversation_id WHERE x.user_id=$1", cid, "[]")
    let docs = export_json_val(c, "SELECT coalesce(jsonb_agg(to_jsonb(d)-'search_vector'),'[]') FROM documents d WHERE owner_id=$1", cid, "[]")
    let usage = export_json_val(c, "SELECT coalesce(jsonb_agg(a),'[]') FROM ai_usage a WHERE user_id=$1", cid, "[]")
    let sess = export_json_val(c, "SELECT coalesce(jsonb_agg(jsonb_build_object('ip',ip,'user_agent',user_agent,'issued_at',issued_at,'expires_at',expires_at,'revoked',revoked)),'[]') FROM user_sessions WHERE user_id=$1", cid, "[]")
    pg_fermer(c)
    let corps = "{\"profil\":" + prof + ",\"conversations\":" + conv + ",\"messages\":" + msgs + ",\"documents\":" + docs + ",\"usage_ia\":" + usage + ",\"sessions\":" + sess + "}"
    var rep = reponse_json(corps)
    rep = reponse_avec_entete(rep, "Content-Disposition", "attachment; filename=\"export-nolcore.json\"")
    return WebResultat.WebOk(rep)
}

fn api_account_delete(req: Requete, _params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401,"Unauthorized","Authentification requise.",req) }
    let mot = champ_entree(req, "password")
    if not has(mot) { return erreur_json(422,"Unprocessable Content","Mot de passe requis pour confirmer.",req) }
    let conn = db(); if not has(conn) { return erreur_json(503,"Service Unavailable","Base PostgreSQL indisponible.",req) }
    let res = pg_requete_params(unwrap_or(conn,ptr_null()), "SELECT password_hash FROM users WHERE id=$1", [unwrap_or(id,"")])
    if not has(res) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(500,"Internal Server Error","Lecture impossible.",req) }
    let r = unwrap_or(res,ptr_null()); let hash = unwrap_or(pg_valeur(r,0,0),""); pg_liberer(r)
    if not mot_de_passe_verifie(hash, bytes_from_text(unwrap_or(mot,""))) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(401,"Unauthorized","Mot de passe invalide.",req) }
    let del = pg_requete_params(unwrap_or(conn,ptr_null()), "DELETE FROM users WHERE id=$1", [unwrap_or(id,"")])
    if has(del) { pg_liberer(unwrap_or(del,ptr_null())) }
    pg_fermer(unwrap_or(conn,ptr_null()))
    return WebResultat.WebOk(reponse_json("{\"deleted\":true}"))
}

// ---------- Passkeys (WebAuthn) ----------

fn wa_rpid() -> Text { return unwrap_or(env("NOLCORE_WEBAUTHN_RPID"), "localhost") }
// L'enregistrement d'une passkey se fait depuis account.<domaine> et la
// connexion depuis login.<domaine> : ce sont deux ORIGINES DIFFÉRENTES.
// Une seule origine configurée rejetterait systématiquement l'une des deux
// cérémonies WebAuthn. NOLCORE_WEBAUTHN_ORIGINS : liste séparée par des
// virgules (repli sur NOLCORE_WEBAUTHN_ORIGIN pour compatibilité).
fn wa_origine_valide(origine: Text) -> Bool {
    let liste = unwrap_or(env("NOLCORE_WEBAUTHN_ORIGINS"), unwrap_or(env("NOLCORE_WEBAUTHN_ORIGIN"), "http://localhost:8080"))
    for candidate in split(liste, ",") {
        if trim(candidate) == origine { return true }
    }
    return false
}

fn api_passkey_register_begin(req: Requete, _params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401,"Unauthorized","Authentification requise.",req) }
    let conn = db(); if not has(conn) { return erreur_json(503,"Service Unavailable","Base PostgreSQL indisponible.",req) }
    let ob = random_bytes(32)
    if not has(ob) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(500,"Internal Server Error","Aléa indisponible.",req) }
    let challenge = base64url_encode(unwrap_or(ob, bytes_new()))
    let ins = pg_requete_params(unwrap_or(conn,ptr_null()), "INSERT INTO webauthn_challenges(challenge,user_id,kind) VALUES($1,$2,'register')", [challenge, unwrap_or(id,"")])
    if has(ins) { pg_liberer(unwrap_or(ins,ptr_null())) }
    let ur = pg_requete_params(unwrap_or(conn,ptr_null()), "SELECT email,display_name FROM users WHERE id=$1", [unwrap_or(id,"")])
    var email = ""; var nom = ""
    if has(ur) { let r = unwrap_or(ur,ptr_null()); if pg_lignes(r)==1 { email = unwrap_or(pg_valeur(r,0,0),""); nom = unwrap_or(pg_valeur(r,0,1),"") } pg_liberer(r) }
    pg_fermer(unwrap_or(conn,ptr_null()))
    let user_id_b64 = base64url_encode(bytes_from_text(unwrap_or(id,"")))
    let corps = "{\"challenge\":" + json_texte(challenge) + ",\"rp\":{\"id\":" + json_texte(wa_rpid()) + ",\"name\":\"NolCore\"},\"user\":{\"id\":" + json_texte(user_id_b64) + ",\"name\":" + json_texte(email) + ",\"displayName\":" + json_texte(nom) + "},\"pubKeyCredParams\":[{\"type\":\"public-key\",\"alg\":-8}],\"timeout\":60000,\"attestation\":\"none\",\"authenticatorSelection\":{\"residentKey\":\"preferred\",\"userVerification\":\"preferred\"}}"
    return WebResultat.WebOk(reponse_json(corps))
}

fn api_passkey_register_finish(req: Requete, _params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401,"Unauthorized","Authentification requise.",req) }
    let ocorps = requete_json(req)
    if not has(ocorps) { return erreur_json(400,"Bad Request","JSON invalide.",req) }
    let body = unwrap_or(ocorps, "")
    let cd_b64 = unwrap_or(json_chemin_texte(body, "response.clientDataJSON"), "")
    let att_b64 = unwrap_or(json_chemin_texte(body, "response.attestationObject"), "")
    if cd_b64 == "" or att_b64 == "" { return erreur_json(422,"Unprocessable Content","Réponse WebAuthn incomplète.",req) }
    let cd_bytes = unwrap_or(base64url_decode(cd_b64), bytes_new())
    let cd_text = unwrap_or(bytes_to_text(cd_bytes), "")
    if unwrap_or(json_texte_champ(cd_text, "type"),"") != "webauthn.create" { return erreur_json(400,"Bad Request","Type WebAuthn inattendu.",req) }
    if not wa_origine_valide(unwrap_or(json_texte_champ(cd_text, "origin"),"")) { return erreur_json(400,"Bad Request","Origine non autorisée.",req) }
    let chal = unwrap_or(json_texte_champ(cd_text, "challenge"), "")
    let conn = db(); if not has(conn) { return erreur_json(503,"Service Unavailable","Base PostgreSQL indisponible.",req) }
    let ch = pg_requete_params(unwrap_or(conn,ptr_null()), "DELETE FROM webauthn_challenges WHERE challenge=$1 AND kind='register' AND user_id=$2 AND expires_at>now() RETURNING challenge", [chal, unwrap_or(id,"")])
    var chal_ok = false
    if has(ch) { let r = unwrap_or(ch,ptr_null()); chal_ok = pg_lignes(r)==1; pg_liberer(r) }
    if not chal_ok { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(400,"Bad Request","Challenge invalide ou expiré.",req) }
    let att = unwrap_or(base64url_decode(att_b64), bytes_new())
    let oad = cbor_map_bstr(att, "authData")
    if not has(oad) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(400,"Bad Request","authData absent.",req) }
    let ad = unwrap_or(oad, bytes_new())
    if bit_and(ad_flags(ad), 64) == 0 { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(400,"Bad Request","Aucune credential attestée.",req) }
    let off = ad_cose_offset(ad)
    let alg = cose_alg(ad, off)
    if alg != (0 - 8) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(400,"Bad Request","Algorithme non supporté (utilisez une passkey EdDSA).",req) }
    let ox = cose_x(ad, off)
    if not has(ox) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(400,"Bad Request","Clé publique illisible.",req) }
    let cred_id_b64 = base64url_encode(ad_cred_id(ad))
    let pk_b64 = base64url_encode(unwrap_or(ox, bytes_new()))
    let ins2 = pg_requete_params(unwrap_or(conn,ptr_null()), "INSERT INTO webauthn_credentials(user_id,credential_id,public_key,alg,sign_count) VALUES($1,$2,$3,$4,$5) ON CONFLICT (credential_id) DO NOTHING RETURNING id", [unwrap_or(id,""), cred_id_b64, pk_b64, text(alg), text(ad_sign_count(ad))])
    if has(ins2) { pg_liberer(unwrap_or(ins2,ptr_null())) }
    pg_fermer(unwrap_or(conn,ptr_null()))
    return WebResultat.WebOk(reponse_json("{\"registered\":true,\"credential_id\":" + json_texte(cred_id_b64) + "}"))
}

fn api_passkey_login_begin(req: Requete, _params: Map<Text>) -> WebResultat {
    let email = champ_entree(req, "email")
    if not has(email) { return erreur_json(422,"Unprocessable Content","email obligatoire.",req) }
    let conn = db(); if not has(conn) { return erreur_json(503,"Service Unavailable","Base PostgreSQL indisponible.",req) }
    let ur = pg_requete_params(unwrap_or(conn,ptr_null()), "SELECT id FROM users WHERE email=$1", [unwrap_or(email,"")])
    var uid = ""
    if has(ur) { let r = unwrap_or(ur,ptr_null()); if pg_lignes(r)==1 { uid = unwrap_or(pg_valeur(r,0,0),"") } pg_liberer(r) }
    let ob = random_bytes(32)
    if not has(ob) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(500,"Internal Server Error","Aléa indisponible.",req) }
    let challenge = base64url_encode(unwrap_or(ob, bytes_new()))
    var allow = "["
    if uid != "" {
        let ins = pg_requete_params(unwrap_or(conn,ptr_null()), "INSERT INTO webauthn_challenges(challenge,user_id,kind) VALUES($1,$2,'login')", [challenge, uid])
        if has(ins) { pg_liberer(unwrap_or(ins,ptr_null())) }
        let cr = pg_requete_params(unwrap_or(conn,ptr_null()), "SELECT credential_id FROM webauthn_credentials WHERE user_id=$1", [uid])
        if has(cr) { let r = unwrap_or(cr,ptr_null()); var i = 0; while i < pg_lignes(r) { if i>0 { allow += "," } allow += "{\"type\":\"public-key\",\"id\":" + json_texte(unwrap_or(pg_valeur(r,i,0),"")) + "}"; i = i + 1 } pg_liberer(r) }
    } else {
        let ins = pg_requete_params(unwrap_or(conn,ptr_null()), "INSERT INTO webauthn_challenges(challenge,user_id,kind) VALUES($1,NULL,'login')", [challenge])
        if has(ins) { pg_liberer(unwrap_or(ins,ptr_null())) }
    }
    allow += "]"
    pg_fermer(unwrap_or(conn,ptr_null()))
    return WebResultat.WebOk(reponse_json("{\"challenge\":" + json_texte(challenge) + ",\"rpId\":" + json_texte(wa_rpid()) + ",\"allowCredentials\":" + allow + ",\"userVerification\":\"preferred\",\"timeout\":60000}"))
}

fn api_passkey_login_finish(req: Requete, _params: Map<Text>) -> WebResultat {
    let ocorps = requete_json(req)
    if not has(ocorps) { return erreur_json(400,"Bad Request","JSON invalide.",req) }
    let body = unwrap_or(ocorps, "")
    let cred_id = unwrap_or(json_texte_champ(body, "id"), "")
    let cd_b64 = unwrap_or(json_chemin_texte(body, "response.clientDataJSON"), "")
    let adata_b64 = unwrap_or(json_chemin_texte(body, "response.authenticatorData"), "")
    let sig_b64 = unwrap_or(json_chemin_texte(body, "response.signature"), "")
    if cred_id == "" or cd_b64 == "" or adata_b64 == "" or sig_b64 == "" { return erreur_json(422,"Unprocessable Content","Réponse WebAuthn incomplète.",req) }
    let cd_bytes = unwrap_or(base64url_decode(cd_b64), bytes_new())
    let cd_text = unwrap_or(bytes_to_text(cd_bytes), "")
    if unwrap_or(json_texte_champ(cd_text,"type"),"") != "webauthn.get" or not wa_origine_valide(unwrap_or(json_texte_champ(cd_text,"origin"),"")) { return erreur_json(400,"Bad Request","Contexte WebAuthn invalide.",req) }
    let chal = unwrap_or(json_texte_champ(cd_text, "challenge"), "")
    let conn = db(); if not has(conn) { return erreur_json(503,"Service Unavailable","Base PostgreSQL indisponible.",req) }
    let cr = pg_requete_params(unwrap_or(conn,ptr_null()), "SELECT user_id,public_key FROM webauthn_credentials WHERE credential_id=$1", [cred_id])
    if not has(cr) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(401,"Unauthorized","Credential inconnue.",req) }
    let rr = unwrap_or(cr,ptr_null())
    if pg_lignes(rr) != 1 { pg_liberer(rr); pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(401,"Unauthorized","Credential inconnue.",req) }
    let uid = unwrap_or(pg_valeur(rr,0,0),"")
    let pk_b64 = unwrap_or(pg_valeur(rr,0,1),"")
    pg_liberer(rr)
    let ch = pg_requete_params(unwrap_or(conn,ptr_null()), "DELETE FROM webauthn_challenges WHERE challenge=$1 AND kind='login' AND (user_id=$2 OR user_id IS NULL) AND expires_at>now() RETURNING challenge", [chal, uid])
    var chal_ok = false
    if has(ch) { let r = unwrap_or(ch,ptr_null()); chal_ok = pg_lignes(r) >= 1; pg_liberer(r) }
    if not chal_ok { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(400,"Bad Request","Challenge invalide ou expiré.",req) }
    let pk = unwrap_or(base64url_decode(pk_b64), bytes_new())
    let ad_bytes = unwrap_or(base64url_decode(adata_b64), bytes_new())
    let sig = unwrap_or(base64url_decode(sig_b64), bytes_new())
    if not webauthn_verifie_ed25519(pk, ad_bytes, cd_bytes, sig) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(401,"Unauthorized","Signature invalide.",req) }
    let up = pg_requete_params(unwrap_or(conn,ptr_null()), "UPDATE webauthn_credentials SET sign_count=$1 WHERE credential_id=$2", [text(ad_sign_count(ad_bytes)), cred_id])
    if has(up) { pg_liberer(unwrap_or(up,ptr_null())) }
    let ur = pg_requete_params(unwrap_or(conn,ptr_null()), "SELECT email FROM users WHERE id=$1", [uid])
    var email = ""
    if has(ur) { let r = unwrap_or(ur,ptr_null()); if pg_lignes(r)==1 { email = unwrap_or(pg_valeur(r,0,0),"") } pg_liberer(r) }
    let token = session_signe(unwrap_or(env("NOLIAE_SESSION_SECRET"), ""), uid, 86400, maintenant_epoch())
    let cookie = cookie_session(unwrap_or(env("NOLIAE_SESSION_SECRET"), ""), email, ip_requete(req))
    if has(cookie) {
        let cookie_hash = hmac_sha256_hex(bytes_from_text(unwrap_or(env("NOLIAE_SESSION_SECRET"), "")), bytes_from_text(unwrap_or(cookie,"")))
        let session_id = random_hex(16)
        if has(session_id) and has(token) {
            let bearer_hash = hmac_sha256_hex(bytes_from_text(unwrap_or(env("NOLIAE_SESSION_SECRET"), "")), bytes_from_text(unwrap_or(token,"")))
            let ss = pg_requete_params(unwrap_or(conn,ptr_null()), "INSERT INTO user_sessions(session_id,token_hash,bearer_token_hash,user_id,email,ip,user_agent,expires_at) VALUES($1,$2,$3,$4,$5,$6,$7,now()+interval '24 hours')", [unwrap_or(session_id,""),cookie_hash,bearer_hash,uid,email,ip_requete(req),unwrap_or(requete_entete(req,"User-Agent"),"")])
            if has(ss) { pg_liberer(unwrap_or(ss,ptr_null())) }
        }
    }
    pg_fermer(unwrap_or(conn,ptr_null()))
    if not has(token) { return erreur_json(500,"Internal Server Error","Session indisponible.",req) }
    var rep = reponse_json("{\"token\":" + json_texte(unwrap_or(token,"")) + ",\"user_id\":" + json_texte(uid) + "}")
    if has(cookie) { rep = reponse_cookie_domaine(rep, "nol_session", unwrap_or(cookie,""), 86400, true, lower(unwrap_or(env("NOLIAE_COOKIE_SECURE"),"false")) == "true", "Lax", unwrap_or(env("NOLIAE_COOKIE_DOMAIN"),"")) }
    return WebResultat.WebOk(rep)
}

fn api_document(req: Requete, _params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401, "Unauthorized", "Authentification requise.", req) }
    let corps = requete_json(req)
    if not has(corps) { return erreur_json(400, "Bad Request", "JSON invalide.", req) }
    let source = unwrap_or(corps, "")
    let titre = json_texte_champ(source, "title")
    let contenu = json_texte_champ(source, "content")
    if not has(titre) or not has(contenu) { return erreur_json(422, "Unprocessable Content", "title et content sont obligatoires.", req) }
    let conn = db()
    if not has(conn) { return erreur_json(503, "Service Unavailable", "Base PostgreSQL indisponible.", req) }
    let res = pg_requete_params(unwrap_or(conn, ptr_null()), "INSERT INTO documents(owner_id,title,content) VALUES($1,$2,$3) RETURNING id", [unwrap_or(id,""), unwrap_or(titre,""), unwrap_or(contenu,"")])
    if not has(res) { pg_fermer(unwrap_or(conn, ptr_null())); return erreur_json(500, "Internal Server Error", "Création du document impossible.", req) }
    let sortie = unwrap_or(res, ptr_null())
    let doc_id = unwrap_or(pg_valeur(sortie, 0, 0), "")
    pg_liberer(sortie); pg_fermer(unwrap_or(conn, ptr_null()))
    return WebResultat.WebOk(reponse_json("{\"id\":" + json_texte(doc_id) + "}"))
}

fn api_admin_users(req: Requete, _params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401, "Unauthorized", "Authentification requise.", req) }
    let conn = db()
    if not has(conn) { return erreur_json(503, "Service Unavailable", "Base PostgreSQL indisponible.", req) }
    let role = pg_requete_params(unwrap_or(conn, ptr_null()), "SELECT role FROM users WHERE id=$1", [unwrap_or(id,"")])
    if not has(role) or pg_lignes(unwrap_or(role, ptr_null())) != 1 or unwrap_or(pg_valeur(unwrap_or(role, ptr_null()),0,0), "user") != "admin" { if has(role) { pg_liberer(unwrap_or(role,ptr_null())) }; pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(403, "Forbidden", "Droit administrateur requis.", req) }
    pg_liberer(unwrap_or(role, ptr_null()))
    let res = pg_requete(unwrap_or(conn, ptr_null()), "SELECT id,email,display_name,role,created_at FROM users ORDER BY id DESC LIMIT 100")
    if not has(res) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(500, "Internal Server Error", "Lecture des utilisateurs impossible.", req) }
    let sortie = unwrap_or(res, ptr_null())
    var items = "["
    var i = 0
    while i < pg_lignes(sortie) { if i > 0 { items = items + "," }; items = items + "{\"id\":" + json_texte(unwrap_or(pg_valeur(sortie,i,0),"")) + ",\"email\":" + json_texte(unwrap_or(pg_valeur(sortie,i,1),"")) + ",\"name\":" + json_texte(unwrap_or(pg_valeur(sortie,i,2),"")) + ",\"role\":" + json_texte(unwrap_or(pg_valeur(sortie,i,3),"")) + "}"; i = i + 1 }
    items = items + "]"
    pg_liberer(sortie); pg_fermer(unwrap_or(conn,ptr_null()))
    return WebResultat.WebOk(reponse_json(items))
}

fn api_permissions(req: Requete, _params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401, "Unauthorized", "Authentification requise.", req) }
    let conn = db()
    if not has(conn) { return erreur_json(503, "Service Unavailable", "Base PostgreSQL indisponible.", req) }
    let res = pg_requete_params(unwrap_or(conn,ptr_null()), "SELECT permission_code FROM user_permissions WHERE user_id=$1 ORDER BY permission_code", [unwrap_or(id,"")])
    if not has(res) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(500,"Internal Server Error","Lecture des permissions impossible.",req) }
    let sortie = unwrap_or(res,ptr_null())
    var items = "["
    var i = 0
    while i < pg_lignes(sortie) { if i > 0 { items = items + "," }; items = items + json_texte(unwrap_or(pg_valeur(sortie,i,0),"")); i = i + 1 }
    items = items + "]"
    pg_liberer(sortie); pg_fermer(unwrap_or(conn,ptr_null()))
    return WebResultat.WebOk(reponse_json(items))
}

fn parametre(params: Map<Text>, nom: Text) -> Text { return unwrap_or(map_get(params, nom), "") }
// Valide le format UUID AVANT toute requête ::uuid : sans ça, un id hérité
// d'avant la migration (ancien id numérique en cache navigateur) fait
// échouer le cast SQL, et la requête ratée était traitée comme une panne
// serveur (500) au lieu d'un simple « conversation introuvable » (404).
fn est_uuid(v: Text) -> Bool {
    if len(v) != 36 { return false }
    var i = 0
    while i < 36 {
        let c = sub(v, i, 1)
        if i == 8 or i == 13 or i == 18 or i == 23 {
            if c != "-" { return false }
        } else if not contains("0123456789abcdefABCDEF", c) {
            return false
        }
        i = i + 1
    }
    return true
}

fn api_ia_modele(req: Requete, params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401,"Unauthorized","Authentification requise.",req) }
    let fournisseur = parametre(params, "nameid")
    let modele = parametre(params, "modelia")
    let texte = parametre(params, "text")
    if fournisseur == "" or modele == "" or texte == "" { return erreur_json(422,"Unprocessable Content","Fournisseur, modèle et texte sont obligatoires.",req) }
    let service_url = unwrap_or(env("NOLCORE_IA_URL"), "")
    if service_url != "" {
        let body = "{\"provider\":" + json_texte(fournisseur) + ",\"model\":" + json_texte(modele) + ",\"text\":" + json_texte(texte) + "}"
        let service = http_post(service_url + "/v1/ia", "application/json", body)
        if not has(service) { return erreur_json(502,"Bad Gateway","Service IA indisponible.",req) }
        let reponse = unwrap_or(service, ReponseHttp { statut:0, entetes:"", corps:"" })
        if reponse.statut >= 300 { return erreur_json(502,"Bad Gateway","Service IA indisponible.",req) }
        return WebResultat.WebOk(reponse_json(reponse.corps))
    }
    return erreur_json(503,"Service Unavailable","Service IA non configuré.",req)
}

// Catalogue exposé à l'interface : seuls les fournisseurs configurés sont
// proposés. Aucun token ni détail sensible ne quitte le Core.
fn api_ia_modeles(req: Requete, _params: Map<Text>) -> WebResultat {
    if not has(utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))) { return erreur_json(401,"Unauthorized","Authentification requise.",req) }
    let service_url = unwrap_or(env("NOLCORE_IA_URL"),"")
    if service_url != "" {
        let live = http_get(service_url + "/v1/ia/models")
        if has(live) and unwrap_or(live,ReponseHttp {statut:0,entetes:"",corps:""}).statut < 300 { return WebResultat.WebOk(reponse_json(unwrap_or(live,ReponseHttp {statut:0,entetes:"",corps:"[]"}).corps)) }
    }
    var items = ""
    var sep = ""
    if unwrap_or(env("NOLCORE_CHATGPT_TOKEN"),"") != "" { items += sep + "{\"provider\":\"chatgpt\",\"model\":\"gpt-4o-mini\",\"label\":\"ChatGPT\"}"; sep = "," }
    if unwrap_or(env("NOLCORE_CLAUDE_TOKEN"),"") != "" { items += sep + "{\"provider\":\"claude\",\"model\":\"claude-3-5-sonnet-latest\",\"label\":\"Claude\"}"; sep = "," }
    if unwrap_or(env("NOLCORE_MISTRAL_TOKEN"),"") != "" { items += sep + "{\"provider\":\"mistral\",\"model\":\"mistral-small-latest\",\"label\":\"Mistral\"}"; sep = "," }
    if unwrap_or(env("NOLCORE_GEMINI_TOKEN"),"") != "" { items += sep + "{\"provider\":\"gemini\",\"model\":\"gemini-1.5-flash\",\"label\":\"Gemini\"}"; sep = "," }
    if items == "" { items = "{\"provider\":" + json_texte(unwrap_or(env("NOLCORE_DEFAULT_PROVIDER"),"chatgpt")) + ",\"model\":" + json_texte(unwrap_or(env("NOLCORE_DEFAULT_MODEL"),"gpt-4o-mini")) + ",\"label\":\"Modèle par défaut\"}" }
    return WebResultat.WebOk(reponse_json("[" + items + "]"))
}

fn api_user_reset(req: Requete, _params: Map<Text>) -> WebResultat {
    // Phase 2 : le lien signé et le nouveau mot de passe. Ce parcours ne
    // dépend d'aucune session existante et révoque tous les appareils.
    let token = champ_entree(req,"token")
    let nouveau = champ_entree(req,"password")
    if has(token) or has(nouveau) {
        if not has(token) or not has(nouveau) or len(unwrap_or(nouveau,"")) < 8 { return erreur_json(422,"Unprocessable Content","token et password (8 caractères minimum) sont obligatoires.",req) }
        let hash_token = hmac_sha256_hex(bytes_from_text(unwrap_or(env("NOLIAE_SESSION_SECRET"),"")),bytes_from_text(unwrap_or(token,"")))
        let hash_password = mot_de_passe_hache(bytes_from_text(unwrap_or(nouveau,"")))
        if not has(hash_password) { return erreur_json(500,"Internal Server Error","Hachage indisponible.",req) }
        let conn = db(); if not has(conn) { return erreur_json(503,"Service Unavailable","Base PostgreSQL indisponible.",req) }
        let db_conn = unwrap_or(conn,ptr_null())
        let changed = pg_requete_params(db_conn,"UPDATE users SET password_hash=$1 WHERE id=(SELECT user_id FROM password_reset_tokens WHERE token_hash=$2 AND used_at IS NULL AND expires_at>now()) RETURNING id",[unwrap_or(hash_password,""),hash_token])
        if not has(changed) or pg_lignes(unwrap_or(changed,ptr_null())) != 1 { if has(changed) { pg_liberer(unwrap_or(changed,ptr_null())) }; pg_fermer(db_conn); return erreur_json(400,"Bad Request","Token invalide ou expiré.",req) }
        let user_id = unwrap_or(pg_valeur(unwrap_or(changed,ptr_null()),0,0),"")
        pg_liberer(unwrap_or(changed,ptr_null()))
        let used = pg_requete_params(db_conn,"UPDATE password_reset_tokens SET used_at=now() WHERE token_hash=$1",[hash_token]); if has(used) { pg_liberer(unwrap_or(used,ptr_null())) }
        let revoked = pg_requete_params(db_conn,"UPDATE user_sessions SET revoked=true WHERE user_id=$1",[user_id]); if has(revoked) { pg_liberer(unwrap_or(revoked,ptr_null())) }
        pg_fermer(db_conn)
        return WebResultat.WebOk(reponse_json("{\"updated\":true}"))
    }
    // Phase 1 : toujours la même réponse afin de ne pas révéler les e-mails
    // enregistrés. Le message est envoyé uniquement si le compte existe.
    let email = champ_entree(req,"email")
    if not has(email) { return erreur_json(422,"Unprocessable Content","email obligatoire.",req) }
    let conn = db(); if not has(conn) { return erreur_json(503,"Service Unavailable","Base PostgreSQL indisponible.",req) }
    let db_conn = unwrap_or(conn,ptr_null())
    let account = pg_requete_params(db_conn,"SELECT id FROM users WHERE email=$1",[unwrap_or(email,"")])
    if has(account) and pg_lignes(unwrap_or(account,ptr_null())) == 1 {
        let user_id = unwrap_or(pg_valeur(unwrap_or(account,ptr_null()),0,0),"")
        let raw_token = random_hex(32)
        if has(raw_token) {
            let token_hash = hmac_sha256_hex(bytes_from_text(unwrap_or(env("NOLIAE_SESSION_SECRET"),"")),bytes_from_text(unwrap_or(raw_token,"")))
            let old = pg_requete_params(db_conn,"UPDATE password_reset_tokens SET used_at=now() WHERE user_id=$1 AND used_at IS NULL",[user_id]); if has(old) { pg_liberer(unwrap_or(old,ptr_null())) }
            let saved = pg_requete_params(db_conn,"INSERT INTO password_reset_tokens(token_hash,user_id,expires_at) VALUES($1,$2,now()+interval '30 minutes')",[token_hash,user_id]); if has(saved) { pg_liberer(unwrap_or(saved,ptr_null())) }
            let smtp_id = unwrap_or(env("NOLCORE_RESET_SMTP_ID"),unwrap_or(env("NOLCORE_VERIFICATION_SMTP_ID"),""))
            if mail_api_disponible() {
                let from = unwrap_or(env("NOLCORE_RESET_FROM"),unwrap_or(env("NOLCORE_VERIFICATION_FROM"),"no-reply@noliae.com"))
                let url = unwrap_or(env("NOLCORE_RESET_URL"),unwrap_or(env("NOLCORE_PUBLIC_URL"),"http://localhost:8080") + "/reset") + "?token=" + unwrap_or(raw_token,"")
                let _sent = mail_api_envoyer(from, unwrap_or(email,""), "Réinitialisez votre mot de passe", "Utilisez ce lien valable 30 minutes : " + url)
            } else if smtp_id != "" {
                let profile = pg_requete_params(db_conn,"SELECT host,port,username,secret_env FROM smtp_profiles WHERE id=$1 AND enabled=true",[smtp_id])
                if has(profile) and pg_lignes(unwrap_or(profile,ptr_null())) == 1 {
                    let p = unwrap_or(profile,ptr_null()); let host=unwrap_or(pg_valeur(p,0,0),""); let port=unwrap_or(parse_int(unwrap_or(pg_valeur(p,0,1),"465")),465); let username=unwrap_or(pg_valeur(p,0,2),""); let password=unwrap_or(env(unwrap_or(pg_valeur(p,0,3),"")),"")
                    let from = unwrap_or(env("NOLCORE_RESET_FROM"),unwrap_or(env("NOLCORE_VERIFICATION_FROM"),username))
                    let url = unwrap_or(env("NOLCORE_RESET_URL"),unwrap_or(env("NOLCORE_PUBLIC_URL"),"http://localhost:8080") + "/reset") + "?token=" + unwrap_or(raw_token,"")
                    let _sent = smtp_envoyer(host,port,username,password,from,unwrap_or(email,""),"Réinitialisez votre mot de passe","Utilisez ce lien valable 30 minutes : " + url)
                    pg_liberer(p)
                } else if has(profile) { pg_liberer(unwrap_or(profile,ptr_null())) }
            }
        }
    }
    if has(account) { pg_liberer(unwrap_or(account,ptr_null())) }
    pg_fermer(db_conn)
    return WebResultat.WebOk(reponse_json("{\"accepted\":true}"))
}

fn api_user_password(req: Requete, _mode: Text) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401,"Unauthorized","Authentification requise.",req) }
    let nouveau = champ_entree(req, "password")
    if not has(nouveau) or len(unwrap_or(nouveau,"")) < 8 { return erreur_json(422,"Unprocessable Content","password doit contenir au moins 8 caractères.",req) }
    let hash = mot_de_passe_hache(bytes_from_text(unwrap_or(nouveau,"")))
    if not has(hash) { return erreur_json(500,"Internal Server Error","Hachage indisponible.",req) }
    let conn = db()
    if not has(conn) { return erreur_json(503,"Service Unavailable","Base PostgreSQL indisponible.",req) }
    let res = pg_requete_params(unwrap_or(conn,ptr_null()), "UPDATE users SET password_hash=$1 WHERE id=$2", [unwrap_or(hash,""),unwrap_or(id,"")])
    if has(res) { pg_liberer(unwrap_or(res,ptr_null())) }
    let revoked = pg_requete_params(unwrap_or(conn,ptr_null()), "UPDATE user_sessions SET revoked=true WHERE user_id=$1", [unwrap_or(id,"")])
    if has(revoked) { pg_liberer(unwrap_or(revoked,ptr_null())) }
    pg_fermer(unwrap_or(conn,ptr_null()))
    return WebResultat.WebOk(reponse_json("{\"updated\":true}"))
}

fn api_user_field(req: Requete, champ: Text) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401,"Unauthorized","Authentification requise.",req) }
    let valeur = champ_entree(req, champ)
    if not has(valeur) or unwrap_or(valeur,"") == "" { return erreur_json(422,"Unprocessable Content","Valeur obligatoire.",req) }
    let conn = db()
    if not has(conn) { return erreur_json(503,"Service Unavailable","Base PostgreSQL indisponible.",req) }
    var sql = "UPDATE users SET display_name=$1 WHERE id=$2"
    if champ == "email" { sql = "UPDATE users SET email=$1 WHERE id=$2" }
    let res = pg_requete_params(unwrap_or(conn,ptr_null()), sql, [unwrap_or(valeur,""),unwrap_or(id,"")])
    if has(res) { pg_liberer(unwrap_or(res,ptr_null())) }
    pg_fermer(unwrap_or(conn,ptr_null()))
    return WebResultat.WebOk(reponse_json("{\"updated\":true}"))
}

fn api_search_text(req: Requete, params: Map<Text>) -> WebResultat {
    let q = parametre(params, "keyword")
    if q == "" { return erreur_json(422,"Unprocessable Content","keyword obligatoire.",req) }
    var copie = req
    var qs = "q=" + q
    let page = requete_query(req, "page")
    if has(page) { qs = qs + "&page=" + unwrap_or(page, "") }
    let limit = requete_query(req, "limit")
    if has(limit) { qs = qs + "&limit=" + unwrap_or(limit, "") }
    copie.query = qs
    return api_search(copie, params)
}

fn api_search_image(req: Requete, params: Map<Text>) -> WebResultat {
    // Recherche image publique (Brave) : pas de compte requis, comme la
    // recherche texte. Débit par utilisateur si connecté, sinon par IP.
    let id = utilisateur(req,unwrap_or(env("NOLIAE_SESSION_SECRET"),""))
    let cle_rate = unwrap_or(id, "anon:" + unwrap_or(requete_entete(req, "X-Forwarded-For"), "anonymous"))
    let rl = redis_rate_ok("search-img:" + cle_rate, 60, 60)
    if has(rl) and not unwrap_or(rl, true) { return erreur_json(429, "Too Many Requests", "Limite de recherche atteinte, réessayez dans une minute.", req) }
    let keyword = parametre(params,"keyword")
    if len(keyword) < 2 { return erreur_json(422,"Unprocessable Content","keyword doit contenir au moins 2 caractères.",req) }
    let token = unwrap_or(env("NOLCORE_BRAVE_SEARCH_TOKEN"),"")
    if token == "" { return erreur_json(503,"Service Unavailable","Recherche image non configurée.",req) }
    let page = unwrap_or(parse_int(unwrap_or(requete_query(req,"page"),"1")),1)
    let offset = (page - 1) * 20
    let images = http_get_token("https://api.search.brave.com/res/v1/images/search?q=" + url_query_brave(keyword) + "&count=20&offset=" + text(offset),"X-Subscription-Token " + token)
    if not has(images) or unwrap_or(images,ReponseHttp {statut:0,entetes:"",corps:""}).statut >= 300 { return erreur_json(502,"Bad Gateway","Recherche image indisponible.",req) }
    return WebResultat.WebOk(reponse_json(unwrap_or(json_chemin(unwrap_or(images,ReponseHttp {statut:0,entetes:"",corps:"{}"}).corps,"results"),"[]")))
}

// Fournisseur/modèle par défaut pour la « Réponse IA » de la recherche :
// premier fournisseur configuré (même priorité et mêmes modèles que
// api_ia_modeles), pour ne jamais envoyer un identifiant de modèle inventé.
fn search_ia_provider() -> Text {
    if unwrap_or(env("NOLCORE_CHATGPT_TOKEN"),"") != "" { return "chatgpt" }
    if unwrap_or(env("NOLCORE_CLAUDE_TOKEN"),"") != "" { return "claude" }
    if unwrap_or(env("NOLCORE_MISTRAL_TOKEN"),"") != "" { return "mistral" }
    if unwrap_or(env("NOLCORE_GEMINI_TOKEN"),"") != "" { return "gemini" }
    if unwrap_or(env("NOLCORE_GROK_TOKEN"),"") != "" { return "grok" }
    if unwrap_or(env("NOLCORE_DEEPSEEK_TOKEN"),"") != "" { return "deepseek" }
    return unwrap_or(env("NOLCORE_DEFAULT_PROVIDER"),"chatgpt")
}
fn search_ia_modele(provider: Text) -> Text {
    if provider == "chatgpt" { return "gpt-4o-mini" }
    if provider == "claude" { return "claude-3-5-sonnet-latest" }
    if provider == "mistral" { return "mistral-small-latest" }
    if provider == "gemini" { return "gemini-1.5-flash" }
    if provider == "grok" { return "grok-3-mini" }
    if provider == "deepseek" { return "deepseek-chat" }
    return unwrap_or(env("NOLCORE_DEFAULT_MODEL"),"gpt-4o-mini")
}
// Recherche « Réponse IA » : le front attend un TABLEAU de résultats
// (title/description/source, comme les autres modes de recherche), pas
// l'enveloppe brute du service IA. On extrait le texte réel de la réponse
// (voir ia_reponse_texte) avant de la renvoyer.
fn api_search_ia(req: Requete, params: Map<Text>) -> WebResultat {
    if not has(utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))) { return erreur_json(401,"Unauthorized","Authentification requise.",req) }
    let keyword = parametre(params, "keyword")
    if keyword == "" { return erreur_json(422,"Unprocessable Content","keyword obligatoire.",req) }
    let service_url = unwrap_or(env("NOLCORE_IA_URL"), "")
    if service_url == "" { return erreur_json(503,"Service Unavailable","Service IA non configuré.",req) }
    let provider = search_ia_provider()
    let modele = search_ia_modele(provider)
    let body = "{\"provider\":" + json_texte(provider) + ",\"model\":" + json_texte(modele) + ",\"text\":" + json_texte(keyword) + "}"
    let service = http_post(service_url + "/v1/ia", "application/json", body)
    if not has(service) or unwrap_or(service, ReponseHttp { statut:0, entetes:"", corps:"" }).statut >= 300 { return erreur_json(502,"Bad Gateway","Service IA indisponible.",req) }
    let enveloppe = unwrap_or(service, ReponseHttp { statut:0, entetes:"", corps:"" }).corps
    let texte = ia_reponse_texte(enveloppe, provider)
    return WebResultat.WebOk(reponse_json("[{\"title\":\"Réponse IA\",\"description\":" + json_texte(texte) + ",\"source\":\"ia\"}]"))
}

fn api_crawler_visite(req: Requete, params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401,"Unauthorized","Authentification requise.",req) }
    let url = parametre(params,"url")
    let service_url = unwrap_or(env("NOLCORE_CRAWLER_URL"), "")
    if service_url != "" {
        let service = http_post(service_url + "/v1/crawler/visite", "application/json", "{\"url\":" + json_texte(url) + "}")
        if not has(service) { return erreur_json(502,"Bad Gateway","Service crawler indisponible.",req) }
        let reponse = unwrap_or(service, ReponseHttp { statut:0, entetes:"", corps:"" })
        if reponse.statut >= 300 { return erreur_json(502,"Bad Gateway","Service crawler indisponible.",req) }
        return WebResultat.WebOk(reponse_json(reponse.corps))
    }
    return erreur_json(503,"Service Unavailable","Service crawler non configuré.",req)
}

// Proxy PUBLIC (comme PageSpeed Insights, pas de compte requis) vers le
// moteur d'analyse SEO du crawler (seo.nol). Limité par IP via Redis : ce
// endpoint fait faire une requête sortante arbitraire au crawler pour
// n'importe quel visiteur, donc sans limite il deviendrait un proxy SSRF/DoS
// gratuit.
fn api_seo_analyser(req: Requete, _params: Map<Text>) -> WebResultat {
    let ip = ip_requete(req)
    let rl = redis_rate_ok("seo:" + ip, 10, 300)
    if has(rl) and not unwrap_or(rl,true) { return erreur_json(429,"Too Many Requests","Trop d'analyses SEO récentes, réessayez dans quelques minutes.",req) }
    let corps = requete_json(req)
    if not has(corps) { return erreur_json(400,"Bad Request","JSON invalide.",req) }
    let url = unwrap_or(json_texte_champ(unwrap_or(corps,""),"url"),"")
    if url == "" { return erreur_json(422,"Unprocessable Content","url obligatoire.",req) }
    let service_url = unwrap_or(env("NOLCORE_CRAWLER_URL"), "")
    if service_url == "" { return erreur_json(503,"Service Unavailable","Service crawler non configuré.",req) }
    let service = http_post(service_url + "/v1/seo/analyser", "application/json", "{\"url\":" + json_texte(url) + "}")
    if not has(service) { return erreur_json(502,"Bad Gateway","Service crawler indisponible.",req) }
    let reponse = unwrap_or(service, ReponseHttp { statut:0, entetes:"", corps:"" })
    if reponse.statut >= 300 { return WebResultat.WebEchec(erreur_http(reponse.statut,"SEO","Analyse impossible pour cette URL.",requete_id(req))) }
    return WebResultat.WebOk(reponse_json(reponse.corps))
}

fn api_crawler_result(req: Requete, params: Map<Text>) -> WebResultat {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return erreur_json(401,"Unauthorized","Authentification requise.",req) }
    let url = parametre(params,"url")
    let conn = db()
    if not has(conn) { return erreur_json(503,"Service Unavailable","Base PostgreSQL indisponible.",req) }
    let res = pg_requete_params(unwrap_or(conn,ptr_null()), "SELECT id,title,content FROM documents WHERE owner_id=$1 AND title=$2 ORDER BY id DESC LIMIT 1", [unwrap_or(id,""),url])
    if not has(res) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(404,"Not Found","Résultat introuvable.",req) }
    let sortie = unwrap_or(res,ptr_null())
    if pg_lignes(sortie) != 1 { pg_liberer(sortie); pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(404,"Not Found","Résultat introuvable.",req) }
    let answer = "{\"id\":" + json_texte(unwrap_or(pg_valeur(sortie,0,0),"")) + ",\"url\":" + json_texte(url) + ",\"content\":" + json_texte(unwrap_or(pg_valeur(sortie,0,2),"")) + "}"
    pg_liberer(sortie); pg_fermer(unwrap_or(conn,ptr_null()))
    return WebResultat.WebOk(reponse_json(answer))
}

fn api_discord_bot(req: Requete, _params: Map<Text>) -> WebResultat {
    if not has(utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))) { return erreur_json(401,"Unauthorized","Authentification requise.",req) }
    let configured = unwrap_or(env("NOLCORE_DISCORD_BOT_TOKEN"), "") != ""
    return WebResultat.WebOk(reponse_json("{\"configured\":" + json_bool(configured) + ",\"guild_id\":" + json_texte(unwrap_or(env("NOLCORE_DISCORD_GUILD_ID"),"")) + "}"))
}

fn api_discord_webhook(req: Requete, _params: Map<Text>) -> WebResultat {
    if not has(utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))) { return erreur_json(401,"Unauthorized","Authentification requise.",req) }
    let message = champ_entree(req, "content")
    let webhook = unwrap_or(env("NOLCORE_DISCORD_WEBHOOK_URL"), "")
    if webhook == "" { return erreur_json(503,"Service Unavailable","Webhook Discord non configuré.",req) }
    if not has(message) or unwrap_or(message,"") == "" { return erreur_json(422,"Unprocessable Content","content obligatoire.",req) }
    let rep = http_post(webhook, "application/json", "{\"content\":" + json_texte(unwrap_or(message,"")) + "}")
    if not has(rep) or unwrap_or(rep,ReponseHttp { statut:0,entetes:"",corps:"" }).statut >= 300 { return erreur_json(502,"Bad Gateway","Discord a refusé le webhook.",req) }
    return WebResultat.WebOk(reponse_json("{\"sent\":true}"))
}

fn admin_autorise(req: Requete) -> Bool {
    let id = utilisateur(req, unwrap_or(env("NOLIAE_SESSION_SECRET"), ""))
    if not has(id) { return false }
    let conn = db()
    if not has(conn) { return false }
    let res = pg_requete_params(unwrap_or(conn,ptr_null()), "SELECT role FROM users WHERE id=$1", [unwrap_or(id,"")])
    if not has(res) { pg_fermer(unwrap_or(conn,ptr_null())); return false }
    let sortie = unwrap_or(res,ptr_null())
    let ok = pg_lignes(sortie) == 1 and unwrap_or(pg_valeur(sortie,0,0),"") == "admin"
    pg_liberer(sortie); pg_fermer(unwrap_or(conn,ptr_null()))
    return ok
}

fn api_smtp_send(req: Requete, params: Map<Text>) -> WebResultat {
    if not admin_autorise(req) { return erreur_json(403,"Forbidden","Droit administrateur requis.",req) }
    let smtp = parametre(params,"idsmtp")
    let to = champ_entree(req,"to")
    let subject = champ_entree(req,"subject")
    let body = champ_entree(req,"body")
    if smtp == "" or not has(to) or not has(subject) or not has(body) { return erreur_json(422,"Unprocessable Content","smtp, to, subject et body sont obligatoires.",req) }
    let conn = db()
    if not has(conn) { return erreur_json(503,"Service Unavailable","PostgreSQL indisponible.",req) }
    let profile = pg_requete_params(unwrap_or(conn,ptr_null()), "SELECT host,port,username,secret_env FROM smtp_profiles WHERE id=$1 AND enabled=true", [smtp])
    if not has(profile) or pg_lignes(unwrap_or(profile,ptr_null())) != 1 { if has(profile) { pg_liberer(unwrap_or(profile,ptr_null())) }; pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(404,"Not Found","Profil SMTP introuvable.",req) }
    let p = unwrap_or(profile,ptr_null())
    let host = unwrap_or(pg_valeur(p,0,0),"")
    let port = unwrap_or(parse_int(unwrap_or(pg_valeur(p,0,1),"587")),587)
    let username = unwrap_or(pg_valeur(p,0,2),"")
    let secret_env = unwrap_or(pg_valeur(p,0,3),"")
    let password = unwrap_or(env(secret_env),"")
    let expediteur = unwrap_or(env("NOLCORE_SMTP_" + upper(smtp) + "_FROM"),username)
    let ok = smtp_envoyer(host,port,username,password,expediteur,unwrap_or(to,""),unwrap_or(subject,""),unwrap_or(body,""))
    var status = "failed"
    if ok { status = "sent" }
    let res = pg_requete_params(unwrap_or(conn,ptr_null()), "INSERT INTO smtp_outbox(smtp_id,recipient,subject,body,status) VALUES($1,$2,$3,$4,$5) RETURNING id", [smtp,unwrap_or(to,""),unwrap_or(subject,""),unwrap_or(body,""),status])
    if not has(res) { pg_liberer(p); pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(500,"Internal Server Error","Enregistrement SMTP impossible.",req) }
    let sortie = unwrap_or(res,ptr_null())
    let id = unwrap_or(pg_valeur(sortie,0,0),"")
    pg_liberer(sortie); pg_liberer(p); pg_fermer(unwrap_or(conn,ptr_null()))
    if not ok { return erreur_json(502,"Bad Gateway","Échec de la livraison SMTP, message conservé en échec.",req) }
    return WebResultat.WebOk(reponse_json("{\"sent\":true,\"id\":" + json_texte(id) + "}"))
}

fn api_smtp_pool(req: Requete, params: Map<Text>) -> WebResultat {
    if not admin_autorise(req) { return erreur_json(403,"Forbidden","Droit administrateur requis.",req) }
    let conn = db()
    if not has(conn) { return erreur_json(503,"Service Unavailable","PostgreSQL indisponible.",req) }
    let res = pg_requete_params(unwrap_or(conn,ptr_null()), "SELECT id,recipient,subject,status FROM smtp_outbox WHERE smtp_id=$1 ORDER BY id DESC LIMIT 100", [parametre(params,"idsmtp")])
    if not has(res) { pg_fermer(unwrap_or(conn,ptr_null())); return erreur_json(500,"Internal Server Error","Pool SMTP indisponible.",req) }
    let sortie = unwrap_or(res,ptr_null())
    var items = "["
    var i = 0
    while i < pg_lignes(sortie) { if i > 0 { items += "," }; items += "{\"id\":" + json_texte(unwrap_or(pg_valeur(sortie,i,0),"")) + ",\"to\":" + json_texte(unwrap_or(pg_valeur(sortie,i,1),"")) + ",\"subject\":" + json_texte(unwrap_or(pg_valeur(sortie,i,2),"")) + ",\"status\":" + json_texte(unwrap_or(pg_valeur(sortie,i,3),"")) + "}"; i = i + 1 }
    items += "]"
    pg_liberer(sortie); pg_fermer(unwrap_or(conn,ptr_null()))
    return WebResultat.WebOk(reponse_json(items))
}

fn api_smtp_remove(req: Requete, params: Map<Text>) -> WebResultat {
    if not admin_autorise(req) { return erreur_json(403,"Forbidden","Droit administrateur requis.",req) }
    let conn = db()
    if not has(conn) { return erreur_json(503,"Service Unavailable","PostgreSQL indisponible.",req) }
    let res = pg_requete_params(unwrap_or(conn,ptr_null()), "DELETE FROM smtp_profiles WHERE id=$1", [parametre(params,"idsmtp")])
    if has(res) { pg_liberer(unwrap_or(res,ptr_null())) }
    pg_fermer(unwrap_or(conn,ptr_null()))
    return WebResultat.WebOk(reponse_json("{\"removed\":true}"))
}

fn api_admin_smtp_create(req: Requete, _params: Map<Text>) -> WebResultat {
    if not admin_autorise(req) { return erreur_json(403,"Forbidden","Droit administrateur requis.",req) }
    let id = champ_entree(req,"id")
    let host = champ_entree(req,"host")
    let port = champ_entree(req,"port")
    let username = champ_entree(req,"username")
    let secret_env = champ_entree(req,"secret_env")
    if not has(id) or not has(host) or not has(username) or not has(secret_env) { return erreur_json(422,"Unprocessable Content","id, host, username et secret_env sont obligatoires.",req) }
    let conn = db()
    if not has(conn) { return erreur_json(503,"Service Unavailable","PostgreSQL indisponible.",req) }
    let res = pg_requete_params(unwrap_or(conn,ptr_null()), "INSERT INTO smtp_profiles(id,host,port,username,secret_env) VALUES($1,$2,$3,$4,$5) ON CONFLICT(id) DO UPDATE SET host=$2,port=$3,username=$4,secret_env=$5,enabled=true", [unwrap_or(id,""),unwrap_or(host,""),unwrap_or(port,"587"),unwrap_or(username,""),unwrap_or(secret_env,"")])
    if has(res) { pg_liberer(unwrap_or(res,ptr_null())) }
    pg_fermer(unwrap_or(conn,ptr_null()))
    return WebResultat.WebOk(reponse_json("{\"configured\":true}"))
}

fn api_admin_config(req: Requete, section: Text) -> WebResultat {
    if not admin_autorise(req) { return erreur_json(403,"Forbidden","Droit administrateur requis.",req) }
    var configured = false
    if section == "ia" { configured = unwrap_or(env("NOLCORE_CHATGPT_TOKEN"),"") != "" or unwrap_or(env("NOLCORE_MISTRAL_TOKEN"),"") != "" }
    if section == "discord" { configured = unwrap_or(env("NOLCORE_DISCORD_BOT_TOKEN"),"") != "" or unwrap_or(env("NOLCORE_DISCORD_WEBHOOK_URL"),"") != "" }
    return WebResultat.WebOk(reponse_json("{\"section\":" + json_texte(section) + ",\"configured\":" + json_bool(configured) + "}"))
}

